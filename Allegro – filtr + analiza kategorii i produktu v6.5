    function finderAutoStatus(
        analysis
    ) {
        if (
            analysis.sales ===
            null
        )
            return 'SKIPPED';

        if (
            analysis.price !==
                null &&
            analysis.price >
                state.finderMaxPrice
        )
            return 'REJECTED';

        if (
            blockedBrandMatch(
                analysis.brand
            )
        )
            return 'REJECTED';

        if (
            analysis.sales <
            state.finderMinSales
        )
            return 'REJECTED';

        if (
            analysis.official &&
            analysis.brandMatchesShop &&
            (analysis.offers ?? 0) <
                8
        )
            return 'REJECTED';

        if (
            analysis.score >= 65
        )
            return 'ACCEPTED';

        if (
            analysis.score >= 45
        )
            return 'MAYBE';

        return 'REJECTED';
    }

    function finderDecisionReason(
        analysis
    ) {
        if (
            analysis.price !==
                null &&
            analysis.price >
                state.finderMaxPrice
        )
            return `PRICE_ABOVE_${Math.round(
                state.finderMaxPrice
            )}`;

        const blocked =
            blockedBrandMatch(
                analysis.brand
            );

        if (blocked)
            return `BRAND_BLOCKLIST:${blocked}`;

        if (
            analysis.sales ===
            null
        )
            return 'SALES_UNKNOWN';

        if (
            analysis.sales <
            state.finderMinSales
        )
            return `SALES_BELOW_${Math.round(
                state.finderMinSales
            )}`;

        if (
            analysis.official &&
            analysis.brandMatchesShop &&
            (analysis.offers ?? 0) <
                8
        )
            return 'OFFICIAL_SAME_BRAND_LT8';

        if (
            analysis.score >= 85
        )
            return 'SCORE_BANGER';

        if (
            analysis.score >= 65
        )
            return 'SCORE_GOOD';

        if (
            analysis.score >= 45
        )
            return 'SCORE_MAYBE';

        return 'SCORE_LOW';
    }

    async function finderSaveAnalysis(
        analysis
    ) {
        const checkedAt =
            localIso();

        const keyValue =
            productIdentity(
                analysis
            );

        const previous =
            await finderGetProduct(
                keyValue
            );

        const autoStatus =
            finderAutoStatus(
                analysis
            );

        const record = {
            key:
                keyValue,

            productId:
                analysis.productId ||
                null,

            offerId:
                analysis.offerId ||
                null,

            gtin:
                analysis.gtin ||
                null,

            title:
                analysis.title,

            brand:
                analysis.brand,

            status:
                autoStatus,

            score:
                analysis.score,

            sales:
                analysis.sales,

            rating:
                analysis.rating,

            ratings:
                analysis.ratings,

            reviews:
                analysis.reviews,

            catalogueOffers:
                analysis.offers,

            price:
                analysis.price,

            category:
                analysis.category
                    ?.name ||
                'Nie wykryto',

            categoryPath:
                analysis.category
                    ?.path ||
                '',

            categoryUrl:
                analysis.category
                    ?.url ||
                '',

            url:
                analysis.url ||
                canonicalOfferUrl(),

            official:
                analysis.official,

            officialShop:
                analysis.shop,

            brandMatchesShop:
                analysis.brandMatchesShop,

            decisionReason:
                finderDecisionReason(
                    analysis
                ),

            firstSeenAt:
                previous
                    ?.firstSeenAt ||
                checkedAt,

            lastCheckedAt:
                checkedAt,

            checkCount:
                (
                    previous
                        ?.checkCount ||
                    0
                ) + 1
        };

        const db =
            await openFinderDb();

        const tx =
            db.transaction(
                [
                    FINDER_PRODUCTS_STORE,
                    FINDER_CHECKS_STORE
                ],
                'readwrite'
            );

        tx.objectStore(
            FINDER_PRODUCTS_STORE
        ).put(
            record
        );

        tx.objectStore(
            FINDER_CHECKS_STORE
        ).add({
            ...record,

            checkedAt,

            statusAtCheck:
                autoStatus
        });

        await transactionDone(
            tx
        );

        return record;
    }

    function finderStatusLabel(
        status
    ) {
        if (
            status ===
            'ACCEPTED'
        )
            return '❤️ ACCEPTED';

        if (
            status ===
            'MAYBE'
        )
            return '🟡 MAYBE';

        if (
            status ===
            'REJECTED'
        )
            return '❌ REJECTED';

        return '⏭ SKIPPED';
    }

    function filteredFinderRows(
        rows
    ) {
        let result =
            [...rows];

        if (
            state.finderStatusFilter !==
            'ALL'
        ) {
            result =
                result.filter(
                    row =>
                        row.status ===
                        state.finderStatusFilter
                );
        }

        if (
            state.finderDateFilter ===
            'today'
        ) {
            const today =
                localDayKey();

            result =
                result.filter(
                    row =>
                        String(
                            row.lastCheckedAt ||
                            ''
                        ).slice(
                            0,
                            10
                        ) ===
                        today
                );
        }

        const query =
            norm(
                state.finderSearch
            );

        if (query) {
            result =
                result.filter(
                    row =>
                        norm(
                            [
                                row.title,
                                row.brand,
                                row.productId,
                                row.offerId,
                                row.gtin,
                                row.category,
                                row.categoryPath,
                                row.decisionReason
                            ].join(
                                ' '
                            )
                        ).includes(
                            query
                        )
                );
        }

        const sorters = {
            'score-desc':
                (a, b) =>
                    (
                        b.score ??
                        -1
                    ) -
                    (
                        a.score ??
                        -1
                    ) ||
                    (
                        b.sales ??
                        -1
                    ) -
                    (
                        a.sales ??
                        -1
                    ),

            'score-asc':
                (a, b) =>
                    (
                        a.score ??
                        999
                    ) -
                    (
                        b.score ??
                        999
                    ),

            'sales-desc':
                (a, b) =>
                    (
                        b.sales ??
                        -1
                    ) -
                    (
                        a.sales ??
                        -1
                    ) ||
                    (
                        b.score ??
                        -1
                    ) -
                    (
                        a.score ??
                        -1
                    ),

            latest:
                (a, b) =>
                    String(
                        b.lastCheckedAt ||
                        ''
                    ).localeCompare(
                        String(
                            a.lastCheckedAt ||
                            ''
                        )
                    ),

            oldest:
                (a, b) =>
                    String(
                        a.lastCheckedAt ||
                        ''
                    ).localeCompare(
                        String(
                            b.lastCheckedAt ||
                            ''
                        )
                    )
        };

        result.sort(
            sorters[
                state.finderSort
            ] ||
            sorters[
                'score-desc'
            ]
        );

        return result;
    }

    function csvCell(value) {
        let text =
            String(
                value ??
                ''
            );

        if (
            /^[=+\-@]/.test(
                text
            )
        )
            text =
                `'${text}`;

        return `"${text.replaceAll(
            '"',
            '""'
        )}"`;
    }

    function downloadText(
        filename,
        content,
        type =
            'text/plain;charset=utf-8'
    ) {
        const blob =
            new Blob(
                [content],
                {
                    type
                }
            );

        const url =
            URL.createObjectURL(
                blob
            );

        const anchor =
            document.createElement(
                'a'
            );

        anchor.href =
            url;

        anchor.download =
            filename;

        document.body.appendChild(
            anchor
        );

        anchor.click();

        anchor.remove();

        setTimeout(
            () =>
                URL.revokeObjectURL(
                    url
                ),
            1000
        );
    }

