    async function renderFinderDatabase() {
        const resultElement =
            document.getElementById(
                'finder-result'
            );

        const statsElement =
            document.getElementById(
                'finder-stats'
            );

        if (
            !resultElement ||
            !statsElement
        )
            return;

        resultElement.innerHTML =
            '<div class="placeholder">Wczytywanie bazy Product Finder...</div>';

        let allRows;

        try {
            allRows =
                await finderGetAllProducts();
        } catch (error) {
            console.error(
                '[Natan Allegro] Nie udało się odczytać bazy Product Finder.',
                error
            );

            resultElement.innerHTML =
                '<div class="placeholder danger">Nie udało się otworzyć bazy Product Finder.</div>';

            return;
        }

        const counts = {
            total:
                allRows.length,

            accepted:
                allRows.filter(
                    row =>
                        row.status ===
                        'ACCEPTED'
                ).length,

            maybe:
                allRows.filter(
                    row =>
                        row.status ===
                        'MAYBE'
                ).length,

            rejected:
                allRows.filter(
                    row =>
                        row.status ===
                        'REJECTED'
                ).length,

            skipped:
                allRows.filter(
                    row =>
                        row.status ===
                        'SKIPPED'
                ).length
        };

        lastFinderRows =
            filteredFinderRows(
                allRows
            );

        statsElement.innerHTML = `
<div class="finder-stat">
    <span>Wszystkie</span>
    <strong>${fmt(counts.total)}</strong>
</div>

<div class="finder-stat">
    <span>❤️ Accepted</span>
    <strong>${fmt(counts.accepted)}</strong>
</div>

<div class="finder-stat">
    <span>🟡 Maybe</span>
    <strong>${fmt(counts.maybe)}</strong>
</div>

<div class="finder-stat">
    <span>❌ Rejected</span>
    <strong>${fmt(counts.rejected)}</strong>
</div>

<div class="finder-stat">
    <span>⏭ Skipped</span>
    <strong>${fmt(counts.skipped)}</strong>
</div>

<div class="finder-stat">
    <span>Widoczne</span>
    <strong>${fmt(lastFinderRows.length)}</strong>
</div>
`;

        if (
            !lastFinderRows.length
        ) {
            resultElement.innerHTML =
                '<div class="placeholder">Brak produktów pasujących do aktualnych filtrów.</div>';

            return;
        }

        const rows =
            lastFinderRows
                .slice(
                    0,
                    300
                )
                .map(
                    row => {
                        const statusClass =
                            String(
                                row.status ||
                                'SKIPPED'
                            ).toLowerCase();

                        const link =
                            row.url
                                ? `<a class="finder-link" href="${esc(
                                    row.url
                                )}" target="_blank" rel="noopener noreferrer">OTWÓRZ</a>`
                                : '—';

                        return `
<tr>
    <td>
        <span class="finder-badge ${statusClass}">
            ${esc(
                finderStatusLabel(
                    row.status
                )
            )}
        </span>
    </td>

    <td class="finder-num">
        ${fmt(row.score)}
    </td>

    <td class="finder-num">
        ${fmt(row.sales)}
    </td>

    <td class="finder-num">
        ${
            row.price ===
                null ||
            row.price ===
                undefined
                ? '—'
                : `${fmt(
                    row.price,
                    2
                )} zł`
        }
    </td>

    <td class="finder-product">
        <strong>
            ${esc(
                row.title ||
                'Nie wykryto'
            )}
        </strong>

        <small>
            ${esc(
                row.brand ||
                'Nie wykryto'
            )}
            ·
            ${esc(
                row.category ||
                'Nie wykryto'
            )}
        </small>

        <small>
            ${esc(
                row.decisionReason ||
                ''
            )}
        </small>
    </td>

    <td class="finder-num">
        ${
            row.rating ===
                null ||
            row.rating ===
                undefined
                ? '—'
                : fmt(
                    row.rating,
                    2
                )
        }
    </td>

    <td class="finder-num">
        ${fmt(
            row.catalogueOffers
        )}
    </td>

    <td class="finder-date">
        ${esc(
            formatCheckedAt(
                row.lastCheckedAt
            )
        )}

        <small>
            ${fmt(
                row.checkCount
            )}× sprawdzony
        </small>
    </td>

    <td>
        ${link}
    </td>
</tr>
`;
                    }
                )
                .join('');

        const limitNote =
            lastFinderRows.length >
            300
                ? `<div class="note">Wyświetlam pierwsze 300 z ${fmt(
                    lastFinderRows.length
                )} wyników. Eksport obejmuje wszystkie widoczne po filtrach.</div>`
                : '';

        resultElement.innerHTML = `
${limitNote}

<div class="finder-table-wrap">
    <table class="finder-table">
        <thead>
            <tr>
                <th>Status</th>
                <th>Score</th>
                <th>Sales</th>
                <th>Cena</th>
                <th>Produkt</th>
                <th>Rating</th>
                <th>Oferty</th>
                <th>Checked At</th>
                <th>Link</th>
            </tr>
        </thead>

        <tbody>
            ${rows}
        </tbody>
    </table>
</div>
`;
    }

