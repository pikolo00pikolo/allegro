    function activateFinderView(
        view
    ) {
        const selected =
            [
                'finder',
                'database'
            ].includes(
                view
            )
                ? view
                : 'finder';

        state.finderView =
            selected;

        save();

        document.querySelectorAll(
            '.finder-subtab'
        ).forEach(
            button => {
                button.classList.toggle(
                    'active',
                    button.dataset.finderView ===
                    selected
                );
            }
        );

        document.querySelectorAll(
            '.finder-view'
        ).forEach(
            section => {
                section.classList.toggle(
                    'active',
                    section.id ===
                    `finder-view-${selected}`
                );
            }
        );

        if (
            selected ===
            'database'
        )
            renderFinderDatabase();
        else
            renderFinderAutomation();
    }

    function activate(name) {
        const selected =
            [
                'category',
                'product',
                'filter',
                'advanced',
                'finder'
            ].includes(
                name
            )
                ? name
                : 'category';

        state.activeTab =
            selected;

        save();

        document.querySelectorAll(
            '.tab'
        ).forEach(
            button =>
                button.classList.toggle(
                    'active',
                    button.dataset.tab ===
                    selected
                )
        );

        document.querySelectorAll(
            '.pane'
        ).forEach(
            pane =>
                pane.classList.toggle(
                    'active',
                    pane.id ===
                    `pane-${selected}`
                )
        );

        const panel =
            document.getElementById(
                'natan-panel-v63'
            );

        panel?.classList.toggle(
            'finder-active',
            selected ===
                'finder' &&
            !state.collapsed
        );

        if (
            selected ===
            'finder'
        )
            activateFinderView(
                state.finderView
            );
    }

    function bind() {
        const panel =
            document.getElementById(
                'natan-panel-v63'
            );

        document.getElementById(
            'natan-collapse'
        ).onclick =
            event => {
                state.collapsed =
                    !state.collapsed;

                panel.classList.toggle(
                    'collapsed',
                    state.collapsed
                );

                panel.classList.toggle(
                    'finder-active',
                    state.activeTab ===
                        'finder' &&
                    !state.collapsed
                );

                event.currentTarget.textContent =
                    state.collapsed
                        ? '+'
                        : '—';

                save();
            };

        document.querySelectorAll(
            '.tab'
        ).forEach(
            button => {
                button.onclick =
                    () =>
                        activate(
                            button.dataset.tab
                        );
            }
        );

        document.querySelectorAll(
            '.finder-subtab'
        ).forEach(
            button => {
                button.onclick =
                    () =>
                        activateFinderView(
                            button.dataset.finderView
                        );
            }
        );

        const bindNumber = (
            id,
            property,
            minimum,
            maximum,
            round = true
        ) => {
            document.getElementById(
                id
            ).addEventListener(
                'input',
                event => {
                    if (
                        event.target.value ===
                        ''
                    )
                        return;

                    let value =
                        Number(
                            event.target.value
                        );

                    if (round)
                        value =
                            Math.round(
                                value
                            );

                    state[property] =
                        clamp(
                            value,
                            minimum,
                            maximum
                        );

                    event.target.value =
                        state[property];

                    save();

                    if (
                        lastProduct &&
                        [
                            'profitPercent',
                            'profitCustom',
                            'finderMaxPrice',
                            'finderMinSales'
                        ].includes(
                            property
                        )
                    ) {
                        lastProduct.pricing =
                            pricing(
                                lastProduct.price
                            );

                        lastProduct.score =
                            productScore(
                                lastProduct
                            );

                        lastProduct.verdict =
                            productVerdict(
                                lastProduct
                            );

                        renderProduct();
                    }

                    if (
                        property ===
                            'finderMaxPages' ||
                        property ===
                            'finderMinSales' ||
                        property ===
                            'finderMaxPrice'
                    ) {
                        renderFinderAutomation();
                    }
                }
            );
        };

        bindNumber(
            'category-min',
            'categoryMinSales',
            1,
            9999
        );

        bindNumber(
            'category-max',
            'maxCategoryOffers',
            100,
            999999
        );

        bindNumber(
            'category-strong',
            'minStrongOffers',
            1,
            100
        );

        bindNumber(
            'profit-custom',
            'profitCustom',
            0,
            10000
        );

        bindNumber(
            'finder-min-sales',
            'finderMinSales',
            1,
            9999
        );

        bindNumber(
            'finder-max-pages',
            'finderMaxPages',
            1,
            100
        );

        bindNumber(
            'finder-max-price',
            'finderMaxPrice',
            1,
            100000
        );

        const profitMode =
            document.getElementById(
                'profit-mode'
            );

        const syncProfitMode =
            () => {
                document.querySelector(
                    '.profit-percent'
                ).classList.toggle(
                    'hidden',
                    state.profitMode !==
                    'percent'
                );

                document.querySelector(
                    '.profit-custom'
                ).classList.toggle(
                    'hidden',
                    state.profitMode !==
                    'custom'
                );
            };

        profitMode.onchange =
            event => {
                state.profitMode =
                    event.target.value ===
                    'custom'
                        ? 'custom'
                        : 'percent';

                save();

                syncProfitMode();

                if (lastProduct) {
                    lastProduct.pricing =
                        pricing(
                            lastProduct.price
                        );

                    renderProduct();
                }
            };

        syncProfitMode();

        const filterRange =
            document.getElementById(
                'filter-range'
            );

        const filterNumber =
            document.getElementById(
                'filter-num'
            );

        const setFilter =
            value => {
                state.filterMinSales =
                    clamp(
                        Math.round(
                            Number(
                                value
                            )
                        ),
                        0,
                        999
                    );

                filterRange.value =
                    state.filterMinSales;

                filterNumber.value =
                    state.filterMinSales;

                save();
            };

        filterRange.oninput =
            event =>
                setFilter(
                    event.target.value
                );

        filterNumber.oninput =
            event => {
                if (
                    event.target.value !==
                    ''
                )
                    setFilter(
                        event.target.value
                    );
            };

        document.getElementById(
            'hide-sponsored'
        ).onchange =
            event => {
                state.hideSponsored =
                    event.target.checked;

                save();
            };

        document.getElementById(
            'hide-unknown'
        ).onchange =
            event => {
                state.hideUnknown =
                    event.target.checked;

                save();
            };

        document.getElementById(
            'finder-mode'
        ).onchange =
            event => {
                state.finderMode =
                    event.target.value ===
                    'current'
                        ? 'current'
                        : 'auto';

                save();

                renderFinderAutomation();
            };

        document.getElementById(
            'finder-blocked-brands'
        ).addEventListener(
            'input',
            event => {
                state.finderBlockedBrands =
                    event.target.value;

                save();

                if (lastProduct) {
                    lastProduct.score =
                        productScore(
                            lastProduct
                        );

                    lastProduct.verdict =
                        productVerdict(
                            lastProduct
                        );

                    renderProduct();
                }
            }
        );

        document.getElementById(
            'finder-excluded-categories'
        ).addEventListener(
            'input',
            event => {
                state.finderExcludedCategories =
                    event.target.value;

                save();
            }
        );

        document.getElementById(
            'finder-auto-save'
        ).onchange =
            event => {
                state.finderAutoSave =
                    event.target.checked;

                save();
            };

        document.getElementById(
            'finder-start'
        ).onclick =
            startFinderCrawler;

        document.getElementById(
            'finder-pause'
        ).onclick =
            pauseFinderCrawler;

        document.getElementById(
            'finder-stop'
        ).onclick =
            stopFinderCrawler;

        document.getElementById(
            'finder-status'
        ).onchange =
            event => {
                state.finderStatusFilter =
                    event.target.value;

                save();

                renderFinderDatabase();
            };

        document.getElementById(
            'finder-date'
        ).onchange =
            event => {
                state.finderDateFilter =
                    event.target.value;

                save();

                renderFinderDatabase();
            };

        document.getElementById(
            'finder-sort'
        ).onchange =
            event => {
                state.finderSort =
                    event.target.value;

                save();

                renderFinderDatabase();
            };

        document.getElementById(
            'finder-search'
        ).oninput =
            event => {
                state.finderSearch =
                    event.target.value;

                save();

                clearTimeout(
                    event.target
                        ._finderTimer
                );

                event.target
                    ._finderTimer =
                        setTimeout(
                            () =>
                                renderFinderDatabase(),
                            180
                        );
            };

        document.getElementById(
            'finder-refresh'
        ).onclick =
            () =>
                renderFinderDatabase();

        document.getElementById(
            'finder-export-csv'
        ).onclick =
            exportFinderCsv;

        document.getElementById(
            'finder-export-json'
        ).onclick =
            exportFinderJson;

        document.getElementById(
            'finder-clear'
        ).onclick =
            async () => {
                if (
                    !confirm(
                        'Na pewno wyczyścić całą pamięć Product Finder? Tej operacji nie można cofnąć.'
                    )
                )
                    return;

                try {
                    await finderClearDatabase();

                    lastFinderRows =
                        [];

                    await renderFinderDatabase();
                } catch (error) {
                    console.error(
                        '[Natan Allegro] Nie udało się wyczyścić bazy Product Finder.',
                        error
                    );

                    alert(
                        'Nie udało się wyczyścić bazy Product Finder.'
                    );
                }
            };

        document.getElementById(
            'natan-category-run'
        ).onclick =
            runCategory;

        document.getElementById(
            'natan-product-run'
        ).onclick =
            runProduct;

        document.getElementById(
            'apply-filter'
        ).onclick =
            applyFilter;

        document.getElementById(
            'remove-filter'
        ).onclick =
            removeFilter;

        document.getElementById(
            'reset-settings'
        ).onclick =
            reset;
    }

