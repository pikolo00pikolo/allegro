    background:#ff5a00;
    border-color:#ff5a00
}

.pane{
    display:none
}

.pane.active{
    display:block
}

.title{
    margin-bottom:9px;
    color:#ff7a2f;
    font-weight:700
}

.num,
.select{
    width:110px;
    height:31px;
    padding:4px 7px;
    border:1px solid #555;
    border-radius:6px;
    color:#fff;
    background:#292929;
    font-weight:700;
    text-align:center
}

.select{
    text-align:left
}

.range{
    width:100%;
    accent-color:#ff5a00
}

.scale{
    display:flex;
    justify-content:space-between;
    color:#999;
    font-size:11px
}

.check{
    width:17px;
    height:17px;
    accent-color:#ff5a00
}

.btn{
    width:100%;
    min-height:34px;
    margin-top:9px;
    padding:7px 9px;
    border:0;
    border-radius:7px;
    color:#fff;
    background:#3a3a3a;
    cursor:pointer;
    font-weight:700
}

.btn.primary{
    background:#ff5a00
}

.btn:disabled{
    opacity:.65;
    cursor:wait
}

.placeholder{
    padding:14px;
    border:1px dashed #555;
    border-radius:8px;
    color:#aaa;
    text-align:center
}

.card{
    margin-top:10px;
    padding:11px;
    border:1px solid #444;
    border-radius:8px;
    background:#272727
}

.summary{
    display:grid;
    grid-template-columns:minmax(0,1fr) auto;
    gap:6px 10px
}

.summary strong{
    text-align:right
}

.verdict{
    margin-top:11px;
    padding:15px 12px;
    border-radius:9px;
    text-align:center
}

.verdict.banger{
    border:2px solid #24ce55;
    background:rgba(36,206,85,.12)
}

.verdict.good{
    border:2px solid #70c756;
    background:rgba(112,199,86,.12)
}

.verdict.medium{
    border:2px solid #e3b63e;
    background:rgba(227,182,62,.12)
}

.verdict.bad{
    border:2px solid #e05252;
    background:rgba(224,82,82,.12)
}

.vlabel{
    font-size:23px;
    font-weight:900
}

.score{
    font-size:17px;
    font-weight:700
}

.desc{
    margin-top:8px;
    color:#d0d0d0;
    font-size:12px
}

.note{
    margin-top:9px;
    color:#aaa;
    font-size:11px
}

.filterSummary{
    margin-top:10px;
    padding:9px;
    border-radius:7px;
    background:#292929;
    color:#ccc;
    font-size:12px
}

.price{
    color:#75e68b;
    font-size:18px
}

.danger{
    color:#ff7979
}

.profit-custom.hidden,
.profit-percent.hidden{
    display:none
}

.ean-bar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:10px;
    margin-top:10px;
    padding:10px 11px;
    border:1px solid #555;
    border-radius:8px;
    background:#1f1f1f
}

.ean-bar .ean-label{
    color:#aaa;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.4px
}

.ean-bar .ean-value{
    font-family:Consolas,monospace;
    font-size:16px;
    font-weight:900;
    letter-spacing:.5px;
    color:#fff;
    user-select:all
}

.ean-bar .ean-status{
    font-size:11px;
    color:#75e68b;
    white-space:nowrap
}

.ean-bar.missing .ean-status{
    color:#ff7979
}

#natan-panel-v63.finder-active{
    width:min(920px,calc(100vw - 36px))
}

.finder-grid{
    display:grid;
    grid-template-columns:repeat(3,minmax(0,1fr));
    gap:7px;
    margin-top:9px
}

.finder-field{
    display:flex;
    flex-direction:column;
    gap:4px
}

.finder-field label{
    color:#aaa;
    font-size:11px;
    font-weight:700
}

.finder-field .select,
.finder-field .num,
.finder-search{
    width:100%;
    height:32px
}

.finder-search{
    padding:6px 8px;
    border:1px solid #555;
    border-radius:6px;
    color:#fff;
    background:#292929
}

.finder-textarea{
    width:100%;
    min-height:64px;
    padding:7px;
    border:1px solid #555;
    border-radius:6px;
    color:#fff;
    background:#292929;
    resize:vertical;
    font-family:Arial,sans-serif
}

.finder-actions{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:7px;
    margin-top:9px
}

.finder-actions .btn{
    margin-top:0;
    font-size:11px
}

.finder-stats{
    display:grid;
    grid-template-columns:repeat(6,1fr);
    gap:6px;
    margin-top:10px
}

.finder-stat{
    padding:8px;
    border:1px solid #444;
    border-radius:7px;
    background:#222;
    text-align:center
}

.finder-stat span{
    display:block;
    color:#aaa;
    font-size:10px
}

.finder-stat strong{
    display:block;
    margin-top:2px;
    font-size:15px
}

.finder-table-wrap{
    margin-top:10px;
    overflow:auto;
    border:1px solid #444;
    border-radius:8px
}

.finder-table{
    width:100%;
    min-width:820px;
    border-collapse:collapse;
    background:#222;
    font-size:11px
}

.finder-table th,
.finder-table td{
    padding:7px 8px;
    border-bottom:1px solid #3b3b3b;
    vertical-align:top
}

.finder-table th{
    position:sticky;
    top:0;
    z-index:1;
    background:#303030;
    color:#bbb;
    text-align:left
}

.finder-table tr:last-child td{
    border-bottom:0
}

.finder-num{
    white-space:nowrap;
    text-align:right
}

.finder-product{
    min-width:230px
}

.finder-product strong{
    display:block;
    color:#fff
}

.finder-product small,
.finder-date small{
    display:block;
    margin-top:3px;
    color:#999
}

.finder-date{
    white-space:nowrap
}

.finder-badge{
    display:inline-block;
    padding:3px 6px;
    border-radius:999px;
    font-size:10px;
    font-weight:800;
    white-space:nowrap
}

.finder-badge.accepted{
    background:rgba(36,206,85,.16);
    color:#75e68b
}

.finder-badge.maybe{
    background:rgba(227,182,62,.16);
    color:#f0cc65
}

.finder-badge.rejected{
    background:rgba(224,82,82,.16);
    color:#ff8989
}

.finder-badge.skipped{
    background:rgba(160,160,160,.14);
    color:#bbb
}

.finder-link{
    display:inline-block;
    padding:5px 7px;
    border-radius:5px;
    background:#ff5a00;
    color:#fff!important;
    font-weight:800;
    text-decoration:none!important
}

.finder-subtabs{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:7px;
    margin:2px 0 12px
}

.finder-subtab{
    height:38px;
    border:1px solid #4a4a4a;
    border-radius:8px;
    background:#262626;
    color:#bbb;
    font-weight:900;
    cursor:pointer
}

.finder-subtab.active{
    background:#ff5a00;
    border-color:#ff5a00;
    color:#fff
}

.finder-view{
    display:none
}

.finder-view.active{
    display:block
}

.finder-run-head{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px
}

.finder-run-buttons{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:7px;
    min-width:360px
}

.finder-run-buttons .btn{
    margin:0
}

.danger-btn{
    background:#8d3030!important
}

.finder-run-status{
    display:inline-block;
    margin-top:3px;
    padding:5px 8px;
    border-radius:999px;
    background:#333;
    font-size:11px;
    font-weight:900
}

.finder-run-status.running{
    color:#75e68b
}

.finder-run-status.paused{
    color:#f0cc65
}

.finder-run-status.finished{
    color:#75e68b
}

.finder-run-status.error,
.finder-run-status.stopped{
    color:#ff8989
}

.finder-log{
    margin-top:10px;
    padding:9px;
    border-radius:7px;
    background:#1f1f1f;
    color:#cfcfcf;
    font-family:Consolas,monospace;
    font-size:11px;
    word-break:break-word
}

@media(max-width:760px){
    #natan-panel-v63.finder-active{
        left:10px;
        right:10px;
        width:auto
    }

    .finder-grid{
        grid-template-columns:1fr
    }

    .finder-stats{
        grid-template-columns:repeat(2,1fr)
    }

    .finder-actions{
        grid-template-columns:repeat(2,1fr)
    }
}
