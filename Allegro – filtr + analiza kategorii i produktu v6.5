                formatCheckedAt(
                    a.finderRecord
                        ?.lastCheckedAt
                )
            )}
        </strong>

        <span>Powód:</span>
        <strong>
            ${esc(
                a.finderRecord
                    ?.decisionReason ||
                '—'
            )}
        </strong>
    </div>
</div>
`
                : (
                    a.finderSaved ===
                    false
                        ? `
<div class="card">
    <div class="danger">
        Nie udało się zapisać wyniku do Product Finder.
    </div>
</div>
`
                        : ''
                );

        document.getElementById(
            'product-result'
        ).innerHTML = `
<div class="verdict ${v.cls}">
    <div class="vlabel">
        ${v.label}
    </div>

    <div class="score">
        ${a.score}/100
    </div>

    <div class="desc">
        ${esc(v.desc)}
    </div>
</div>

${gtinBar}

<div class="card">
    <div class="summary">

        <span>Produkt:</span>
        <strong>${esc(a.title)}</strong>

        <span>Product ID:</span>
        <strong>${esc(a.productId || '—')}</strong>

        <span>Offer ID:</span>
        <strong>${esc(a.offerId || '—')}</strong>

        <span>Sprzedaż produktu:</span>
        <strong>${fmt(a.sales)}</strong>

        <span>Ocena:</span>
        <strong>
            ${
                a.rating ===
                null
                    ? '—'
                    : fmt(
                        a.rating,
                        2
                    )
            }
        </strong>

        <span>Oceny:</span>
        <strong>${fmt(a.ratings)}</strong>

        <span>Recenzje:</span>
        <strong>${fmt(a.reviews)}</strong>

        <span>Ofert w katalogu:</span>
        <strong>${fmt(a.offers)}</strong>

        <span>Marka:</span>
        <strong>${esc(a.brand)}</strong>

        <span>Kategoria:</span>
        <strong>
            ${esc(
                a.category?.name ||
                'Nie wykryto'
            )}
        </strong>

        <span>Oficjalny sklep:</span>
        <strong>${a.official ? 'TAK' : 'NIE'}</strong>

        <span>Marka = sklep:</span>
        <strong>
            ${
                a.brandMatchesShop
                    ? 'TAK'
                    : 'NIE'
            }
        </strong>
    </div>
</div>

<div class="card">
    <div class="summary">
        ${priceBlock}
    </div>
</div>

${finderInfo}
`;

        const gtinValue =
            document.getElementById(
                'natan-ean-value'
            );

        if (
            a.gtin &&
            gtinValue
        ) {
            gtinValue.style.cursor =
                'pointer';

            gtinValue.title =
                'Kliknij, aby skopiować EAN / GTIN';

            gtinValue.onclick =
                async () => {
                    const copied =
                        await copyTextToClipboard(
                            a.gtin
                        );

                    a.gtinCopied =
                        copied;

                    const status =
                        document.getElementById(
                            'natan-ean-status'
                        );

                    if (status) {
                        status.textContent =
                            copied
                                ? 'Skopiowano ✓'
                                : 'Błąd kopiowania';
                    }
                };
        }
    }

    function start() {
        addStyles();

        createPanel();

        renderFinderAutomation();

        const crawler =
            loadFinderCrawlerState();

        if (
            crawler.status ===
            'running'
        ) {
            setTimeout(
                () =>
                    resumeFinderCrawler(),
                700
            );
        }

        console.log(
            '[Natan Allegro v6.5.0] Uruchomiono. SMART + GTIN/EAN + Product Finder AUTO + baza danych.'
        );
    }

    start();

})();
