// ==UserScript==
// @name         Allegro – filtr + analiza kategorii i produktu v6.5
// @namespace    natan-allegro
// @version      6.5.0
// @description  Filtr ofert, analiza kategorii i produktu, SMART kalkulator oraz automatyczny Product Finder z bazą danych.
// @match        https://allegro.pl/*
// @match        https://www.allegro.pl/*
// @run-at       document-idle
// @grant        none
// ==/UserScript==

(() => {
    'use strict';

    const PREFIX = 'natan-allegro-v63-';
    const FINDER_DB_NAME = 'natan-allegro-product-finder-v1';
    const FINDER_DB_VERSION = 1;
    const FINDER_PRODUCTS_STORE = 'products';
    const FINDER_CHECKS_STORE = 'checks';

    const DEFAULTS = {
        activeTab: 'category',
        collapsed: false,

        categoryMinSales: 100,
        maxCategoryOffers: 10000,
        minStrongOffers: 3,

        filterMinSales: 0,
        hideSponsored: false,
        hideUnknown: false,

        profitMode: 'percent',
        profitPercent: 25,
        profitCustom: 100,

        finderMaxPrice: 1000,
        finderBlockedBrands: 'Apple',
        finderAutoSave: true,

        finderMinSales: 100,
        finderMaxPages: 5,
        finderMode: 'auto',

        finderExcludedCategories:
`Moda
Odzież
Obuwie
Bielizna
Czapki`,

        finderView: 'finder',

        finderStatusFilter: 'ACCEPTED',
        finderDateFilter: 'today',
        finderSort: 'score-desc',
        finderSearch: ''
    };

    const key = name => PREFIX + name;

    const clamp = (value, min, max) =>
        Math.min(max, Math.max(min, value));

    const load = (name, fallback) =>
        localStorage.getItem(key(name)) ?? fallback;

    const loadBool = (name, fallback) => {
        const value = localStorage.getItem(key(name));

        return value === null
            ? fallback
            : value === 'true';
    };

    const loadNum = (name, fallback, min, max) => {
        const value = Number(
            localStorage.getItem(key(name))
        );

        return Number.isFinite(value)
            ? clamp(value, min, max)
            : fallback;
    };

    const state = {
        activeTab: load(
            'activeTab',
            DEFAULTS.activeTab
        ),

        collapsed: loadBool(
            'collapsed',
            DEFAULTS.collapsed
        ),

        categoryMinSales: loadNum(
            'categoryMinSales',
            DEFAULTS.categoryMinSales,
            1,
            9999
        ),

        maxCategoryOffers: loadNum(
            'maxCategoryOffers',
            DEFAULTS.maxCategoryOffers,
            100,
            999999
        ),

        minStrongOffers: loadNum(
            'minStrongOffers',
            DEFAULTS.minStrongOffers,
            1,
            100
        ),

        filterMinSales: loadNum(
            'filterMinSales',
            DEFAULTS.filterMinSales,
            0,
            999
        ),

        hideSponsored: loadBool(
            'hideSponsored',
            DEFAULTS.hideSponsored
        ),

        hideUnknown: loadBool(
            'hideUnknown',
            DEFAULTS.hideUnknown
        ),

        profitMode:
            ['percent', 'custom'].includes(
                load(
                    'profitMode',
                    DEFAULTS.profitMode
                )
            )
                ? load(
                    'profitMode',
                    DEFAULTS.profitMode
                )
                : DEFAULTS.profitMode,

        profitPercent: loadNum(
            'profitPercent',
            DEFAULTS.profitPercent,
            1,
            200
        ),

        profitCustom: loadNum(
            'profitCustom',
            DEFAULTS.profitCustom,
            0,
            10000
        ),

        finderMaxPrice: loadNum(
            'finderMaxPrice',
            DEFAULTS.finderMaxPrice,
            1,
            100000
        ),

        finderBlockedBrands: load(
            'finderBlockedBrands',
            DEFAULTS.finderBlockedBrands
        ),

        finderAutoSave: loadBool(
            'finderAutoSave',
            DEFAULTS.finderAutoSave
        ),

        finderMinSales: loadNum(
            'finderMinSales',
            DEFAULTS.finderMinSales,
            1,
            9999
        ),

        finderMaxPages: loadNum(
            'finderMaxPages',
            DEFAULTS.finderMaxPages,
            1,
            100
        ),

        finderMode:
            ['auto', 'current'].includes(
                load(
                    'finderMode',
                    DEFAULTS.finderMode
                )
            )
                ? load(
                    'finderMode',
                    DEFAULTS.finderMode
                )
                : DEFAULTS.finderMode,

        finderExcludedCategories: load(
            'finderExcludedCategories',
            DEFAULTS.finderExcludedCategories
        ),

        finderView:
            ['finder', 'database'].includes(
                load(
                    'finderView',
                    DEFAULTS.finderView
                )
            )
                ? load(
                    'finderView',
                    DEFAULTS.finderView
                )
                : DEFAULTS.finderView,

        finderStatusFilter:
            [
                'ALL',
                'ACCEPTED',
                'MAYBE',
                'REJECTED',
                'SKIPPED'
            ].includes(
                load(
                    'finderStatusFilter',
                    DEFAULTS.finderStatusFilter
                )
            )
                ? load(
                    'finderStatusFilter',
                    DEFAULTS.finderStatusFilter
                )
                : DEFAULTS.finderStatusFilter,

        finderDateFilter:
            ['all', 'today'].includes(
                load(
                    'finderDateFilter',
                    DEFAULTS.finderDateFilter
                )
            )
                ? load(
                    'finderDateFilter',
                    DEFAULTS.finderDateFilter
                )
                : DEFAULTS.finderDateFilter,

        finderSort:
            [
                'score-desc',
                'score-asc',
                'sales-desc',
                'latest',
                'oldest'
            ].includes(
                load(
                    'finderSort',
                    DEFAULTS.finderSort
                )
            )
                ? load(
                    'finderSort',
                    DEFAULTS.finderSort
                )
                : DEFAULTS.finderSort,

        finderSearch: load(
            'finderSearch',
            DEFAULTS.finderSearch
        )
    };

    const CLS = {
        hiddenSales:
            'natan-hidden-sales-v63',

        hiddenSponsored:
            'natan-hidden-sponsored-v63',

        hiddenUnknown:
            'natan-hidden-unknown-v63'
    };

    let lastCategory = null;
    let lastProduct = null;
    let lastFilter = null;

    let lastFinderRows = [];

    let finderDbPromise = null;
    let finderCrawlerBusy = false;

    const migrationVersion = Number(
        localStorage.getItem(
            key('migrationVersion')
        ) || 0
    );

    if (migrationVersion < 640) {
        state.categoryMinSales = Math.max(
            100,
            state.categoryMinSales
        );

        localStorage.setItem(
            key('categoryMinSales'),
            String(state.categoryMinSales)
        );

        localStorage.setItem(
            key('migrationVersion'),
            '640'
        );
    }

    function save() {
        Object.entries(state)
            .forEach(
                ([name, value]) =>
                    localStorage.setItem(
                        key(name),
                        String(value)
                    )
            );
    }

    function reset() {
        Object.keys(localStorage)
            .filter(
                item =>
                    item.startsWith(PREFIX)
            )
            .forEach(
                item =>
                    localStorage.removeItem(
                        item
                    )
            );

        clearFilter();

        location.reload();
    }

    const norm = value =>
        String(value ?? '')
            .replace(/\u00a0/g, ' ')
            .replace(/\s+/g, ' ')
            .trim()
            .toLowerCase();

    const esc = value =>
        String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll(
                "'",
                '&#039;'
            );

    const fmt = (
        value,
        digits = 0
    ) =>
        Number.isFinite(value)
            ? value.toLocaleString(
                'pl-PL',
                {
                    minimumFractionDigits:
                        digits,

                    maximumFractionDigits:
                        digits
                }
            )
            : '—';

    const avg = values =>
        values.length
            ? Math.round(
                values.reduce(
                    (sum, value) =>
                        sum + value,
                    0
                ) /
                values.length
            )
            : 0;

    const pad2 = value =>
        String(value).padStart(
            2,
            '0'
        );

    function localIso(
        date = new Date()
    ) {
        const offset =
            -date.getTimezoneOffset();

        const sign =
            offset >= 0
                ? '+'
                : '-';

        const abs =
            Math.abs(offset);

        return (
            `${date.getFullYear()}-` +
            `${pad2(
                date.getMonth() + 1
            )}-` +
            `${pad2(
                date.getDate()
            )}T` +
            `${pad2(
                date.getHours()
            )}:` +
            `${pad2(
                date.getMinutes()
            )}:` +
            `${pad2(
                date.getSeconds()
            )}` +
            `${sign}` +
            `${pad2(
                Math.floor(abs / 60)
            )}:` +
            `${pad2(abs % 60)}`
        );
    }

    function localDayKey(
        date = new Date()
    ) {
        return (
            `${date.getFullYear()}-` +
            `${pad2(
                date.getMonth() + 1
            )}-` +
            `${pad2(
                date.getDate()
            )}`
        );
    }

    function formatCheckedAt(
        value
    ) {
        if (!value)
            return '—';

        const date =
            new Date(value);

        if (
            Number.isNaN(
                date.getTime()
            )
        )
            return String(value);

        return (
            `${pad2(
                date.getDate()
            )}.` +
            `${pad2(
                date.getMonth() + 1
            )}.` +
            `${date.getFullYear()} ` +
            `${pad2(
                date.getHours()
            )}:` +
            `${pad2(
                date.getMinutes()
            )}:` +
            `${pad2(
                date.getSeconds()
            )}`
        );
    }

    function cleanBrand(value) {
        return norm(value)
            .replace(
                /[^a-z0-9ąćęłńóśźż]/g,
                ''
            );
    }

    function blockedBrands() {
        return String(
            state.finderBlockedBrands ||
            ''
        )
            .split(/[\n,;]+/)
            .map(
                value =>
                    value.trim()
            )
            .filter(Boolean);
    }

    function blockedBrandMatch(
        brand
    ) {
        const current =
            cleanBrand(brand);

        if (
            !current ||
            current ===
                cleanBrand(
                    'Nie wykryto'
                )
        )
            return null;

        return (
            blockedBrands()
                .find(
                    item =>
                        cleanBrand(item) ===
                        current
                ) ||
            null
        );
    }

    function canonicalOfferUrl() {
        const canonical =
            document.querySelector(
                'link[rel="canonical"]'
            )?.href;

        return (
            canonical ||
            `${location.origin}${location.pathname}`
        );
    }

    function currentOfferId() {
        const url =
            canonicalOfferUrl();

        const fromUrl =
            url.match(
                /-(\d{8,})(?:[/?#]|$)/
            );

        if (fromUrl)
            return fromUrl[1];

        const source =
            document
                .documentElement
                ?.innerHTML ||
            '';

        const patterns = [
            /["']offerId["']\s*:\s*["']?(\d{8,})["']?/i,

            /["']offer_id["']\s*:\s*["']?(\d{8,})["']?/i
        ];

        for (
            const pattern of patterns
        ) {
            const match =
                pattern.exec(
                    source
                );

            if (match)
                return match[1];
        }

        return null;
    }

    function currentProductId() {
        const productLink =
            document.querySelector(
                'a[href*="/produkt/"]'
            )?.href || '';

        const uuid =
            productLink.match(
                /([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})/i
            );

        if (uuid)
            return uuid[1];

        const source =
            document
                .documentElement
                ?.innerHTML ||
            '';

        const patterns = [
            /["']catalogProductId["']\s*:\s*["']([^"']+)["']/i,

            /["']productId["']\s*:\s*["']([^"']+)["']/i,

            /["']product_id["']\s*:\s*["']([^"']+)["']/i
        ];

        for (
            const pattern of patterns
        ) {
            const match =
                pattern.exec(
                    source
                );

            if (match)
                return match[1];
        }

        return null;
    }

    function productCategoryContext() {
        const selectors = [
            'nav a[href*="/kategoria/"]',
            'nav a[href*="/dzial/"]',
            '[aria-label*="breadcrumb" i] a[href*="/kategoria/"]',
            '[aria-label*="breadcrumb" i] a[href*="/dzial/"]'
        ];

        const seen =
            new Set();

        const items = [];

        for (
            const selector of selectors
        ) {
            for (
                const anchor of document.querySelectorAll(
                    selector
                )
            ) {
                const name =
                    (
                        anchor.textContent ||
                        ''
                    ).trim();

                const href =
                    anchor.href || '';

                if (
                    !name ||
                    !href ||
                    seen.has(href)
                )
                    continue;

                seen.add(href);

                items.push({
                    name,
                    href
                });
            }
        }

        const last =
            items.at(-1);

        return {
            name:
                last?.name ||
                'Nie wykryto',

            url:
                last?.href ||
                '',

            path:
                items
                    .map(
                        item =>
                            item.name
                    )
                    .join(' > ')
        };
    }

    function productIdentity(
        analysis
    ) {
        if (
            analysis.productId
        )
            return `product:${analysis.productId}`;

        if (analysis.gtin)
            return `gtin:${analysis.gtin}`;

        if (
            analysis.offerId
        )
            return `offer:${analysis.offerId}`;

        return `url:${
            analysis.url ||
            canonicalOfferUrl()
        }`;
    }

    function openFinderDb() {
        if (finderDbPromise)
            return finderDbPromise;

        finderDbPromise =
            new Promise(
                (
                    resolve,
                    reject
                ) => {
                    const request =
                        indexedDB.open(
                            FINDER_DB_NAME,
                            FINDER_DB_VERSION
                        );

                    request.onupgradeneeded =
                        () => {
                            const db =
                                request.result;

                            if (
                                !db.objectStoreNames.contains(
                                    FINDER_PRODUCTS_STORE
                                )
                            ) {
                                const products =
                                    db.createObjectStore(
                                        FINDER_PRODUCTS_STORE,
                                        {
                                            keyPath:
                                                'key'
                                        }
                                    );

                                products.createIndex(
                                    'status',
                                    'status',
                                    {
                                        unique:
                                            false
                                    }
                                );

                                products.createIndex(
                                    'lastCheckedAt',
                                    'lastCheckedAt',
                                    {
                                        unique:
                                            false
                                    }
                                );

                                products.createIndex(
                                    'score',
                                    'score',
                                    {
                                        unique:
                                            false
                                    }
                                );
                            }

                            if (
                                !db.objectStoreNames.contains(
                                    FINDER_CHECKS_STORE
                                )
                            ) {
                                const checks =
                                    db.createObjectStore(
                                        FINDER_CHECKS_STORE,
                                        {
                                            keyPath:
                                                'id',

                                            autoIncrement:
                                                true
                                        }
                                    );

                                checks.createIndex(
                                    'key',
                                    'key',
                                    {
                                        unique:
                                            false
                                    }
                                );

                                checks.createIndex(
                                    'checkedAt',
                                    'checkedAt',
                                    {
                                        unique:
                                            false
                                    }
                                );
                            }
                        };

                    request.onsuccess =
                        () =>
                            resolve(
                                request.result
                            );

                    request.onerror =
                        () =>
                            reject(
                                request.error ||
                                new Error(
                                    'Nie udało się otworzyć bazy Product Finder.'
                                )
                            );
                }
            );

        return finderDbPromise;
    }

    function transactionDone(
        transaction
    ) {
        return new Promise(
            (
                resolve,
                reject
            ) => {
                transaction.oncomplete =
                    () =>
                        resolve();

                transaction.onerror =
                    () =>
                        reject(
                            transaction.error ||
                            new Error(
                                'Błąd transakcji IndexedDB.'
                            )
                        );

                transaction.onabort =
                    () =>
                        reject(
                            transaction.error ||
                            new Error(
                                'Transakcja IndexedDB została przerwana.'
                            )
                        );
            }
        );
    }

    function requestValue(
        request
    ) {
        return new Promise(
            (
                resolve,
                reject
            ) => {
                request.onsuccess =
                    () =>
                        resolve(
                            request.result
                        );

                request.onerror =
                    () =>
                        reject(
                            request.error ||
                            new Error(
                                'Błąd odczytu IndexedDB.'
                            )
                        );
            }
        );
    }

    async function finderGetProduct(
        keyValue
    ) {
        const db =
            await openFinderDb();

        const tx =
            db.transaction(
                FINDER_PRODUCTS_STORE,
                'readonly'
            );

        const result =
            await requestValue(
                tx
                    .objectStore(
                        FINDER_PRODUCTS_STORE
                    )
                    .get(
                        keyValue
                    )
            );

        await transactionDone(
            tx
        );

        return result || null;
    }

    async function finderGetAllProducts() {
        const db =
            await openFinderDb();

        const tx =
            db.transaction(
                FINDER_PRODUCTS_STORE,
                'readonly'
            );

        const result =
            await requestValue(
                tx
                    .objectStore(
                        FINDER_PRODUCTS_STORE
                    )
                    .getAll()
            );

        await transactionDone(
            tx
        );

        return Array.isArray(
            result
        )
            ? result
            : [];
    }

    async function finderClearDatabase() {
        const db =
            await openFinderDb();

        const tx =
            db.transaction(
                [
                    FINDER_PRODUCTS_STORE,
                    FINDER_CHECKS_STORE
                ],
                'readwrite'
            );

        tx
            .objectStore(
                FINDER_PRODUCTS_STORE
            )
            .clear();

        tx
            .objectStore(
                FINDER_CHECKS_STORE
            )
            .clear();

        await transactionDone(
            tx
        );
    }

    function sleep(ms) {
        return new Promise(
            resolve =>
                setTimeout(
                    resolve,
                    ms
                )
        );
    }

    function defaultFinderCrawlerState() {
        return {
            status: 'idle',
            mode: state.finderMode,

            startedAt: null,
            finishedAt: null,

            rootUrl: '',
            rootName: '',

            currentCategory: null,
            currentPage: 1,

            currentCategoryBudget: 1,
            currentCategoryScore: null,
            currentCategoryVerdict: '',

            categoryQueue: [],
            visitedCategories: [],

            pendingProducts: [],
            nextListingUrl: '',

            seenOfferIds: [],

            lastMessage:
                'Gotowy do startu.',

            lastUrl: '',

            counters: {
                categories: 0,
                categoriesDone: 0,
                categoriesSkipped: 0,

                pages: 0,

                candidates: 0,

                analyzed: 0,
                accepted: 0,
                maybe: 0,
                rejected: 0,
                skipped: 0,

                knownSkipped: 0
            }
        };
    }

    function loadFinderCrawlerState() {
        try {
            const raw =
                localStorage.getItem(
                    key(
                        'finderCrawlerState'
                    )
                );

            if (!raw)
                return defaultFinderCrawlerState();

            const parsed =
                JSON.parse(raw);

            return {
                ...defaultFinderCrawlerState(),
                ...parsed,

                counters: {
                    ...defaultFinderCrawlerState()
                        .counters,

                    ...(
                        parsed.counters ||
                        {}
                    )
                }
            };
        } catch (error) {
            console.warn(
                '[Natan Allegro] Uszkodzony stan Product Findera — resetuję automat.',
                error
            );

            return defaultFinderCrawlerState();
        }
    }

    function saveFinderCrawlerState(
        crawler
    ) {
        localStorage.setItem(
            key(
                'finderCrawlerState'
            ),
            JSON.stringify(crawler)
        );

        renderFinderAutomation(
            crawler
        );
    }

    function crawlerStatusLabel(
        status
    ) {
        if (
            status === 'running'
        )
            return '🟢 PRACUJE';

        if (
            status === 'paused'
        )
            return '🟡 PAUZA';

        if (
            status === 'finished'
        )
            return '✅ ZAKOŃCZONY';

        if (
            status === 'stopped'
        )
            return '⛔ ZATRZYMANY';

        if (
            status === 'error'
        )
            return '❌ BŁĄD';

        return '⚪ GOTOWY';
    }

    function pageBaseUrl(
        raw = location.href
    ) {
        try {
            const url =
                new URL(
                    raw,
                    location.origin
                );

            url.hash = '';

            url.searchParams.delete(
                'p'
            );

            return (
                `${url.origin}` +
                `${url.pathname}` +
                `${url.search
                    ? url.search
                    : ''}`
            );
        } catch {
            return String(
                raw || ''
            );
        }
    }

    function categoryKeyFromUrl(
        raw
    ) {
        try {
            const url =
                new URL(
                    raw,
                    location.origin
                );

            return (
                `${url.origin}` +
                `${url.pathname}`
            ).toLowerCase();
        } catch {
            return String(
                raw || ''
            ).toLowerCase();
        }
    }

    function isProductOfferPage() {
        return /\/oferta\//i.test(
            location.pathname
        );
    }

    function categoryBlacklistTokens() {
        return String(
            state.finderExcludedCategories ||
            ''
        )
            .split(/[\n,;]+/)
            .map(
                value =>
                    norm(value)
            )
            .filter(Boolean);
    }

    function excludedCategoryMatch(
        name
    ) {
        const current =
            norm(name);

        if (!current)
            return null;

        return (
            categoryBlacklistTokens()
                .find(
                    token =>
                        current === token ||
                        current.startsWith(
                            `${token} `
                        ) ||
                        current.startsWith(
                            `${token}-`
                        )
                ) ||
            null
        );
    }

    function getSubcategoryLinks() {
        const selectors = [
            '#links-list-Categories a[data-role="LinkItemAnchor"][href]',

            '[data-role="Categories"] a[data-role="LinkItemAnchor"][href]'
        ];

        const result = [];
        const seen =
            new Set();

        for (
            const selector of selectors
        ) {
            for (
                const anchor of document.querySelectorAll(
                    selector
                )
            ) {
                const name =
                    (
                        anchor.textContent ||
                        ''
                    ).trim();

                const href =
                    anchor.href ||
                    anchor.getAttribute(
                        'href'
                    ) ||
                    '';

                if (
                    !name ||
                    !href
                )
                    continue;

                let url;

                try {
                    url =
                        new URL(
                            href,
                            location.origin
                        );
                } catch {
                    continue;
                }

                if (
                    !/\/(?:kategoria|dzial)\//i.test(
                        url.pathname
                    )
                )
                    continue;

                const keyValue =
                    categoryKeyFromUrl(
                        url.href
                    );

                if (
                    seen.has(
                        keyValue
                    )
                )
                    continue;

                seen.add(
                    keyValue
                );

                let meta = null;

                const rawMeta =
                    anchor.getAttribute(
                        'data-custom-params'
                    );

                if (rawMeta) {
                    try {
                        meta =
                            JSON.parse(
                                rawMeta
                            );
                    } catch {}
                }

                result.push({
                    name:
                        meta?.name ||
                        name,

                    id:
                        meta?.id ||
                        null,

                    count:
                        Number.isFinite(
                            Number(
                                meta?.count
                            )
                        )
                            ? Number(
                                meta.count
                            )
                            : null,

                    url:
                        pageBaseUrl(
                            url.href
                        )
                });
            }
        }

        return result;
    }

    function offerUrlFromArticle(
        article
    ) {
        const anchors = [
            ...article.querySelectorAll(
                'h2 a[href], a[href*="/oferta/"][href]'
            )
        ];

        for (
            const anchor of anchors
        ) {
            const raw =
                anchor.href ||
                anchor.getAttribute(
                    'href'
                ) ||
                '';

            if (!raw)
                continue;

            try {
                const url =
                    new URL(
                        raw,
                        location.origin
                    );

                if (
                    /\/oferta\//i.test(
                        url.pathname
                    )
                )
                    return url.href;
            } catch {}
        }

        const fallback =
            anchors[0];

        if (!fallback)
            return null;

        try {
            return new URL(
                fallback.href ||
                fallback.getAttribute(
                    'href'
                ),
                location.origin
            ).href;
        } catch {
            return null;
        }
    }

    function offerIdFromUrl(
        raw
    ) {
        const match =
            String(raw || '')
                .match(
                    /-(\d{8,})(?:[/?#]|$)/
                );

        return match
            ? match[1]
            : null;
    }

    function nextListingPageUrl() {
        const direct =
            document.querySelector(
                'a[rel="next"][href], a[aria-label*="następna" i][href], a[title*="następna" i][href]'
            );

        if (
            direct?.href
        )
            return direct.href;

        const currentP =
            Number(
                new URL(
                    location.href
                )
                    .searchParams
                    .get('p') ||
                1
            );

        const candidates = [
            ...document.querySelectorAll(
                'a[href]'
            )
        ];

        for (
            const anchor of candidates
        ) {
            try {
                const url =
                    new URL(
                        anchor.href,
                        location.origin
                    );

                const p =
                    Number(
                        url.searchParams
                            .get('p')
                    );

                if (
                    Number.isFinite(
                        p
                    ) &&
                    p ===
                        currentP + 1 &&
                    url.pathname ===
                        location.pathname
                ) {
                    return url.href;
                }
            } catch {}
        }

        return null;
    }

    function categoryScanBudget(
        analysis
    ) {
        const maxPages =
            clamp(
                Math.round(
                    state.finderMaxPages
                ),
                1,
                100
            );

        if (!analysis)
            return 1;

        if (
            analysis.score >= 85
        )
            return maxPages;

        if (
            analysis.score >= 65
        )
            return Math.min(
                maxPages,
                Math.max(
                    3,
                    Math.ceil(
                        maxPages *
                        0.7
                    )
                )
            );

        if (
            analysis.score >= 45
        )
            return Math.min(
                maxPages,
                2
            );

        return 1;
    }

    async function finderKnownOfferIds() {
        const rows =
            await finderGetAllProducts();

        return new Set(
            rows
                .map(
                    row =>
                        String(
                            row.offerId ||
                            ''
                        )
                )
                .filter(Boolean)
        );
    }

    function enqueueDiscoveredCategories(
        crawler
    ) {
        if (
            crawler.mode !== 'auto'
        )
            return;

        const visited =
            new Set(
                crawler.visitedCategories ||
                []
            );

        const queued =
            new Set(
                (
                    crawler.categoryQueue ||
                    []
                )
                    .map(
                        item =>
                            categoryKeyFromUrl(
                                item.url
                            )
                    )
            );

        const children =
            getSubcategoryLinks();

        for (
            const child of children
        ) {
            const categoryKey =
                categoryKeyFromUrl(
                    child.url
                );

            if (
                visited.has(
                    categoryKey
                ) ||
                queued.has(
                    categoryKey
                )
            )
                continue;

            const blocked =
                excludedCategoryMatch(
                    child.name
                );

            if (blocked) {
                crawler
                    .counters
                    .categoriesSkipped++;

                continue;
            }

            crawler
                .categoryQueue
                .push({
                    ...child,

                    depth:
                        (
                            crawler
                                .currentCategory
                                ?.depth ||
                            0
                        ) + 1
                });

            queued.add(
                categoryKey
            );
        }
    }

    async function waitForFinderPageReady(
        timeout = 12000
    ) {
        const started =
            Date.now();

        while (
            Date.now() -
            started <
            timeout
        ) {
            if (
                isProductOfferPage()
            ) {
                if (
                    document.querySelector(
                        'h1'
                    )
                )
                    return true;
            } else {
                if (
                    getOfferArticles()
                        .length ||
                    getSubcategoryLinks()
                        .length ||
                    document.querySelector(
                        'h1'
                    )
                )
                    return true;
            }

            await sleep(400);
        }

        return false;
    }

    function crawlerControlAllowsRun(
        crawler
    ) {
        const latest =
            loadFinderCrawlerState();

        if (
            latest.startedAt &&
            crawler.startedAt &&
            latest.startedAt ===
                crawler.startedAt &&
            [
                'paused',
                'stopped'
            ].includes(
                latest.status
            )
        ) {
            crawler.status =
                latest.status;

            crawler.lastMessage =
                latest.lastMessage;

            return false;
        }

        return (
            crawler.status ===
            'running'
        );
    }

    function crawlerNavigate(
        crawler,
        url,
        message
    ) {
        if (
            !url ||
            !crawlerControlAllowsRun(
                crawler
            )
        ) {
            saveFinderCrawlerState(
                crawler
            );

            return false;
        }

        if (message)
            crawler.lastMessage =
                message;

        crawler.lastUrl =
            url;

        saveFinderCrawlerState(
            crawler
        );

        location.href =
            url;

        return true;
    }

    async function crawlerAdvanceCategory(
        crawler
    ) {
        if (
            crawler.mode ===
            'current'
        ) {
            crawler.status =
                'finished';

            crawler.finishedAt =
                localIso();

            crawler.lastMessage =
                'Zakończono skanowanie obecnej kategorii.';

            saveFinderCrawlerState(
                crawler
            );

            return;
        }

        const visited =
            new Set(
                crawler.visitedCategories ||
                []
            );

        while (
            crawler.categoryQueue
                .length
        ) {
            const next =
                crawler.categoryQueue
                    .shift();

            const nextKey =
                categoryKeyFromUrl(
                    next.url
                );

            if (
                visited.has(
                    nextKey
                )
            )
                continue;

            const blocked =
                excludedCategoryMatch(
                    next.name
                );

            if (blocked) {
                crawler
                    .counters
                    .categoriesSkipped++;

                continue;
            }

            crawler.currentCategory =
                next;

            crawler.currentPage =
                1;

            crawler.currentCategoryBudget =
                1;

            crawler.currentCategoryScore =
                null;

            crawler.currentCategoryVerdict =
                '';

            crawler.pendingProducts =
                [];

            crawler.nextListingUrl =
                '';

            crawler
                .visitedCategories
                .push(
                    nextKey
                );

            crawler
                .counters
                .categories++;

            crawler.lastMessage =
                `Przechodzę do kategorii: ${next.name}`;

            saveFinderCrawlerState(
                crawler
            );

            crawlerNavigate(
                crawler,
                next.url,
                crawler.lastMessage
            );

            return;
        }

        crawler.status =
            'finished';

        crawler.finishedAt =
            localIso();

        crawler.lastMessage =
            'Kolejka kategorii zakończona.';

        saveFinderCrawlerState(
            crawler
        );
    }

    async function crawlerContinueAfterProducts(
        crawler
    ) {
        if (
            crawler.pendingProducts
                ?.length
        ) {
            const next =
                crawler.pendingProducts
                    .shift();

            crawlerNavigate(
                crawler,
                next.url,
                `Analizuję produkt ${crawler.counters.analyzed + 1}: ${
                    next.title ||
                    next.offerId ||
                    'oferta'
                }`
            );

            return;
        }

        if (
            crawler.nextListingUrl
        ) {
            const nextUrl =
                crawler.nextListingUrl;

            crawler.nextListingUrl =
                '';

            crawler.currentPage++;

            crawlerNavigate(
                crawler,
                nextUrl,
                `Kategoria ${
                    crawler
                        .currentCategory
                        ?.name ||
                    '—'
                } — strona ${
                    crawler.currentPage
                }/${
                    crawler
                        .currentCategoryBudget
                }`
            );

            return;
        }

        crawler
            .counters
            .categoriesDone++;

        crawler.currentCategory =
            null;

        crawler.currentPage =
            1;

        crawler.currentCategoryBudget =
            1;

        crawler.currentCategoryScore =
            null;

        crawler.currentCategoryVerdict =
            '';

        await crawlerAdvanceCategory(
            crawler
        );
    }

    async function crawlerHandleProduct(
        crawler
    ) {
        const offerId =
            currentOfferId();

        const productId =
            currentProductId();

        if (productId) {
            const existing =
                await finderGetProduct(
                    `product:${productId}`
                );

            if (existing) {
                crawler
                    .counters
                    .knownSkipped++;

                if (
                    offerId &&
                    !crawler
                        .seenOfferIds
                        .includes(
                            String(
                                offerId
                            )
                        )
                ) {
                    crawler
                        .seenOfferIds
                        .push(
                            String(
                                offerId
                            )
                        );
                }

                crawler.lastMessage =
                    `Pomijam znany Product ID: ${productId}`;

                crawlerControlAllowsRun(
                    crawler
                );

                saveFinderCrawlerState(
                    crawler
                );

                if (
                    crawler.status ===
                    'running'
                ) {
                    await crawlerContinueAfterProducts(
                        crawler
                    );
                }

                return;
            }
        }

        const analysis =
            analyzeProduct();

        lastProduct =
            analysis;

        let record;

        try {
            record =
                await finderSaveAnalysis(
                    analysis
                );

            analysis.finderRecord =
                record;

            analysis.finderSaved =
                true;
        } catch (error) {
            console.error(
                '[Natan Allegro] Automat: błąd zapisu produktu.',
                error
            );

            crawler
                .counters
                .skipped++;

            crawler.lastMessage =
                'Błąd zapisu produktu — przechodzę dalej.';

            saveFinderCrawlerState(
                crawler
            );

            await crawlerContinueAfterProducts(
                crawler
            );

            return;
        }

        crawler
            .counters
            .analyzed++;

        if (
            record.status ===
            'ACCEPTED'
        ) {
            crawler
                .counters
                .accepted++;
        } else if (
            record.status ===
            'MAYBE'
        ) {
            crawler
                .counters
                .maybe++;
        } else if (
            record.status ===
            'REJECTED'
        ) {
            crawler
                .counters
                .rejected++;
        } else {
            crawler
                .counters
                .skipped++;
        }

        if (
            analysis.offerId &&
            !crawler
                .seenOfferIds
                .includes(
                    String(
                        analysis.offerId
                    )
                )
        ) {
            crawler
                .seenOfferIds
                .push(
                    String(
                        analysis.offerId
                    )
                );

            if (
                crawler
                    .seenOfferIds
                    .length >
                15000
            ) {
                crawler
                    .seenOfferIds
                    .splice(
                        0,
                        crawler
                            .seenOfferIds
                            .length -
                        15000
                    );
            }
        }

        crawler.lastMessage =
            `${
                finderStatusLabel(
                    record.status
                )
            } · ${
                analysis.sales ??
                '—'
            } sprzedaży · ${
                analysis.title
            }`;

        crawlerControlAllowsRun(
            crawler
        );

        saveFinderCrawlerState(
            crawler
        );

        if (
            state.activeTab ===
            'product'
        )
            renderProduct();

        if (
            state.activeTab ===
                'finder' &&
            state.finderView ===
                'database'
        )
            renderFinderDatabase();

        if (
            crawler.status !==
            'running'
        )
            return;

        await sleep(250);

        await crawlerContinueAfterProducts(
            crawler
        );
    }

    async function crawlerHandleListing(
        crawler
    ) {
        const records =
            offerRecords();

        const subcategories =
            getSubcategoryLinks();

        if (
            !crawler.currentCategory
        ) {
            const detectedName =
                categoryName();

            crawler.currentCategory =
                {
                    name:
                        detectedName,

                    url:
                        pageBaseUrl(
                            location.href
                        ),

                    depth: 0
                };

            const currentKey =
                categoryKeyFromUrl(
                    crawler
                        .currentCategory
                        .url
                );

            if (
                !crawler
                    .visitedCategories
                    .includes(
                        currentKey
                    )
            ) {
                crawler
                    .visitedCategories
                    .push(
                        currentKey
                    );

                crawler
                    .counters
                    .categories++;
            }
        }

        if (
            crawler.currentPage ===
            1
        ) {
            enqueueDiscoveredCategories(
                crawler
            );

            if (
                records.length
            ) {
                const analysis =
                    analyzeCategory();

                crawler.currentCategoryScore =
                    analysis.score;

                crawler.currentCategoryVerdict =
                    analysis
                        .verdict
                        ?.label ||
                    '';

                crawler.currentCategoryBudget =
                    categoryScanBudget(
                        analysis
                    );
            } else {
                crawler.currentCategoryScore =
                    null;

                crawler.currentCategoryVerdict =
                    subcategories.length
                        ? 'NAWIGACJA'
                        : 'BRAK DANYCH';

                crawler.currentCategoryBudget =
                    1;
            }
        }

        crawler
            .counters
            .pages++;

        if (
            !records.length
        ) {
            crawler.pendingProducts =
                [];

            crawler.nextListingUrl =
                '';

            crawler.lastMessage =
                subcategories.length
                    ? `Znaleziono ${subcategories.length} podkategorii — przechodzę głębiej.`
                    : 'Na stronie nie wykryto ofert ani kandydatów.';

            crawlerControlAllowsRun(
                crawler
            );

            saveFinderCrawlerState(
                crawler
            );

            if (
                crawler.status ===
                'running'
            ) {
                await crawlerContinueAfterProducts(
                    crawler
                );
            }

            return;
        }

        let knownOffers;

        try {
            knownOffers =
                await finderKnownOfferIds();
        } catch {
            knownOffers =
                new Set();
        }

        const seenThisPage =
            new Set();

        const runSeen =
            new Set(
                (
                    crawler
                        .seenOfferIds ||
                    []
                ).map(String)
            );

        const candidates =
            [];

        for (
            const record of records
        ) {
            if (
                record.sales ===
                    null ||
                record.sales <
                    state.finderMinSales
            )
                continue;

            const url =
                offerUrlFromArticle(
                    record.article
                );

            if (!url)
                continue;

            const offerId =
                offerIdFromUrl(
                    url
                );

            const dedupeKey =
                offerId ||
                url;

            if (
                seenThisPage.has(
                    dedupeKey
                )
            )
                continue;

            seenThisPage.add(
                dedupeKey
            );

            if (
                offerId &&
                (
                    knownOffers.has(
                        String(
                            offerId
                        )
                    ) ||
                    runSeen.has(
                        String(
                            offerId
                        )
                    )
                )
            ) {
                crawler
                    .counters
                    .knownSkipped++;

                continue;
            }

            const title =
                (
                    record.article
                        .querySelector(
                            'h2'
                        )
                        ?.textContent ||
                    ''
                ).trim();

            candidates.push({
                url,
                offerId,
                title,

                listSales:
                    record.sales,

                sponsored:
                    record.sponsored
            });
        }

        candidates.sort(
            (a, b) =>
                (
                    b.listSales ??
                    0
                ) -
                (
                    a.listSales ??
                    0
                )
        );

        crawler
            .counters
            .candidates +=
                candidates.length;

        crawler.pendingProducts =
            candidates;

        const nextPage =
            nextListingPageUrl();

        crawler.nextListingUrl =
            nextPage &&
            crawler.currentPage <
                crawler
                    .currentCategoryBudget
                ? nextPage
                : '';

        crawler.lastMessage =
            `Kategoria: ${
                crawler
                    .currentCategory
                    ?.name ||
                categoryName()
            } · strona ${
                crawler.currentPage
            }/${
                crawler
                    .currentCategoryBudget
            } · kandydaci ≥${
                state.finderMinSales
            }: ${
                candidates.length
            }`;

        crawlerControlAllowsRun(
            crawler
        );

        saveFinderCrawlerState(
            crawler
        );

        if (
            crawler.status !==
            'running'
        )
            return;

        await crawlerContinueAfterProducts(
            crawler
        );
    }

    async function resumeFinderCrawler() {
        if (finderCrawlerBusy)
            return;

        const crawler =
            loadFinderCrawlerState();

        if (
            crawler.status !==
            'running'
        ) {
            renderFinderAutomation(
                crawler
            );

            return;
        }

        finderCrawlerBusy =
            true;

        try {
            const ready =
                await waitForFinderPageReady();

            if (!ready) {
                crawler.status =
                    'error';

                crawler.lastMessage =
                    'Strona nie załadowała danych w wymaganym czasie. Kliknij START, aby wznowić.';

                saveFinderCrawlerState(
                    crawler
                );

                return;
            }

            if (
                isProductOfferPage()
            ) {
                await crawlerHandleProduct(
                    crawler
                );
            } else {
                await crawlerHandleListing(
                    crawler
                );
            }
        } catch (error) {
            console.error(
                '[Natan Allegro] Product Finder automat — błąd.',
                error
            );

            crawler.status =
                'error';

            crawler.lastMessage =
                `Błąd automatu: ${
                    error?.message ||
                    error
                }`;

            saveFinderCrawlerState(
                crawler
            );
        } finally {
            finderCrawlerBusy =
                false;
        }
    }

    function resolveFinderRoot() {
        if (
            isProductOfferPage()
        ) {
            const category =
                productCategoryContext();

            if (
                category.url
            ) {
                return {
                    url:
                        pageBaseUrl(
                            category.url
                        ),

                    name:
                        category.name
                };
            }

            return null;
        }

        if (
            /\/(?:kategoria|dzial)\//i.test(
                location.pathname
            ) ||
            getOfferArticles()
                .length ||
            getSubcategoryLinks()
                .length
        ) {
            return {
                url:
                    pageBaseUrl(
                        location.href
                    ),

                name:
                    categoryName() !==
                    'Nie wykryto'
                        ? categoryName()
                        : (
                            document.title ||
                            'Aktualna kategoria'
                        )
            };
        }

        return null;
    }

    function startFinderCrawler() {
        let crawler =
            loadFinderCrawlerState();

        if (
            crawler.status ===
                'paused' ||
            crawler.status ===
                'error'
        ) {
            crawler.status =
                'running';

            crawler.lastMessage =
                'Wznawiam Product Finder.';

            saveFinderCrawlerState(
                crawler
            );

            resumeFinderCrawler();

            return;
        }

        const root =
            resolveFinderRoot();

        if (!root) {
            alert(
                'Otwórz najpierw kategorię/dział Allegro albo stronę produktu należącego do kategorii.'
            );

            return;
        }

        const blocked =
            excludedCategoryMatch(
                root.name
            );

        if (blocked) {
            alert(
                `Ta kategoria pasuje do blacklisty: ${blocked}. Usuń ją z blacklisty albo uruchom Finder w innej kategorii.`
            );

            return;
        }

        crawler =
            defaultFinderCrawlerState();

        crawler.status =
            'running';

        crawler.mode =
            state.finderMode;

        crawler.startedAt =
            localIso();

        crawler.rootUrl =
            root.url;

        crawler.rootName =
            root.name;

        crawler.currentCategory =
            {
                name:
                    root.name,

                url:
                    root.url,

                depth: 0
            };

        crawler.currentPage =
            1;

        crawler.visitedCategories =
            [
                categoryKeyFromUrl(
                    root.url
                )
            ];

        crawler
            .counters
            .categories =
                1;

        crawler.lastMessage =
            `Start: ${root.name}`;

        saveFinderCrawlerState(
            crawler
        );

        if (
            pageBaseUrl(
                location.href
            ) !==
            root.url
        ) {
            crawlerNavigate(
                crawler,
                root.url,
                `Przechodzę do kategorii startowej: ${root.name}`
            );
        } else {
            resumeFinderCrawler();
        }
    }

    function pauseFinderCrawler() {
        const crawler =
            loadFinderCrawlerState();

        if (
            crawler.status !==
            'running'
        )
            return;

        crawler.status =
            'paused';

        crawler.lastMessage =
            'Automat zatrzymany na pauzie. START wznowi od tego miejsca.';

        saveFinderCrawlerState(
            crawler
        );
    }

    function stopFinderCrawler() {
        const crawler =
            loadFinderCrawlerState();

        crawler.status =
            'stopped';

        crawler.finishedAt =
            localIso();

        crawler.pendingProducts =
            [];

        crawler.nextListingUrl =
            '';

        crawler.categoryQueue =
            [];

        crawler.lastMessage =
            'Product Finder zatrzymany. Baza produktów została zachowana.';

        saveFinderCrawlerState(
            crawler
        );
    }

    function renderFinderAutomation(
        crawler =
            loadFinderCrawlerState()
    ) {
        const status =
            document.getElementById(
                'finder-auto-status'
            );

        const details =
            document.getElementById(
                'finder-auto-details'
            );

        const startButton =
            document.getElementById(
                'finder-start'
            );

        const pauseButton =
