    function parseCompact(raw) {
        const text =
            String(raw ?? '')
                .replace(
                    /\u00a0/g,
                    ''
                )
                .replace(
                    /\s+/g,
                    ''
                )
                .replace(
                    ',',
                    '.'
                )
                .toLowerCase();

        let match =
            text.match(
                /^(\d+(?:\.\d+)?)tys\.?\+?$/
            );

        if (match)
            return Math.round(
                Number(
                    match[1]
                ) *
                1000
            );

        match =
            text.match(
                /^(\d+(?:\.\d+)?)mln\.?\+?$/
            );

        if (match)
            return Math.round(
                Number(
                    match[1]
                ) *
                1000000
            );

        const digits =
            text.match(
                /\d+/g
            );

        return digits
            ? Number(
                digits.join('')
            )
            : null;
    }

    function parseSalesText(text) {
        const normalized =
            norm(text);

        let match =
            normalized.match(
                /(\d+(?:[.,]\d+)?)\s*tys\.?\s*(?:osób|osoby|osoba)\s+kupi\w*/
            );

        if (match) {
            const value =
                Number(
                    match[1]
                        .replace(
                            ',',
                            '.'
                        )
                );

            return Number.isFinite(
                value
            )
                ? Math.round(
                    value *
                    1000
                )
                : null;
        }

        match =
            normalized.match(
                /(\d[\d\s]*)\s*(?:osób|osoby|osoba)\s+kupi\w*/
            );

        if (!match)
            return null;

        const value =
            Number(
                match[1]
                    .replace(
                        /\s/g,
                        ''
                    )
            );

        return Number.isFinite(
            value
        )
            ? value
            : null;
    }

    function getOfferArticles() {
        return [
            ...document.querySelectorAll(
                'article'
            )
        ].filter(
            article => {
                const hasTitle =
                    Boolean(
                        article.querySelector(
                            'h2 a'
                        )
                    );

                const hasOffer =
                    Boolean(
                        article.querySelector(
                            'a[href*="/oferta/"], a[href*="/events/clicks"], [data-role-type="add-to-cart-button"]'
                        )
                    );

                return (
                    hasTitle &&
                    hasOffer
                );
            }
        );
    }

    function visualContainer(
        article
    ) {
        const listItem =
            article.closest(
                'li'
            );

        return (
            listItem &&
            listItem
                .querySelectorAll(
                    ':scope article'
                )
                .length === 1
        )
            ? listItem
            : article;
    }

    function offerSales(article) {
        for (
            const element of article.querySelectorAll(
                '[aria-label]'
            )
        ) {
            const label =
                element.getAttribute(
                    'aria-label'
                ) ||
                '';

            if (
                norm(
                    label
                ).includes(
                    'kupi'
                )
            ) {
                const sales =
                    parseSalesText(
                        label
                    );

                if (
                    sales !==
                    null
                )
                    return sales;
            }
        }

        return parseSalesText(
            article.textContent ||
            ''
        );
    }

    function offerSponsored(
        article
    ) {
        for (
            const element of article.querySelectorAll(
                'p, span, div'
            )
        ) {
            const text =
                norm(
                    element.textContent
                );

            if (
                [
                    'sponsorowane',
                    'promowane',
                    'oferta sponsorowana'
                ].includes(
                    text
                )
            )
                return true;
        }

        return Boolean(
            article.querySelector(
                'a[href*="/events/clicks"][href*="bi_s%3Dads"], a[href*="/events/clicks"][href*="bi_s=ads"]'
            )
        );
    }

    function offerRecords() {
        return getOfferArticles()
            .map(
                article => {
                    const sales =
                        offerSales(
                            article
                        );

                    const sponsored =
                        offerSponsored(
                            article
                        );

                    article
                        .dataset
                        .natanSales =
                            sales ===
                            null
                                ? 'unknown'
                                : String(
                                    sales
                                );

                    article
                        .dataset
                        .natanSponsored =
                            String(
                                sponsored
                            );

                    return {
                        article,

                        container:
                            visualContainer(
                                article
                            ),

                        sales,

                        sponsored
                    };
                }
            );
    }

    function clearFilter() {
        document.querySelectorAll(
            `.${CLS.hiddenSales}, .${CLS.hiddenSponsored}, .${CLS.hiddenUnknown}`
        ).forEach(
            element => {
                element.classList.remove(
                    CLS.hiddenSales,
                    CLS.hiddenSponsored,
                    CLS.hiddenUnknown
                );
            }
        );
    }

    function applyFilter() {
        const startedAt =
            performance.now();

        clearFilter();

        const records =
            offerRecords();

        let visible = 0;
        let low = 0;
        let sponsored = 0;
        let unknown = 0;

        for (
            const record of records
        ) {
            if (
                record.sponsored &&
                state.hideSponsored
            ) {
                record.container
                    .classList
                    .add(
                        CLS.hiddenSponsored
                    );

                sponsored++;

                continue;
            }

            if (
                record.sales ===
                null
            ) {
                if (
                    state.hideUnknown
                ) {
                    record.container
                        .classList
                        .add(
                            CLS.hiddenUnknown
                        );

                    unknown++;
                } else {
                    visible++;
                }

                continue;
            }

            if (
                record.sales <
                state.filterMinSales
            ) {
                record.container
                    .classList
                    .add(
                        CLS.hiddenSales
                    );

                low++;

                continue;
            }

            visible++;
        }

        lastFilter = {
            total:
                records.length,

            visible,
            low,
            sponsored,
            unknown,

            ms:
                Math.round(
                    performance.now() -
                    startedAt
                )
        };

        renderFilter();
    }

    function removeFilter() {
        clearFilter();

        const amount =
            getOfferArticles()
                .length;

        lastFilter = {
            total:
                amount,

            visible:
                amount,

            low: 0,
            sponsored: 0,
            unknown: 0,
            ms: 0
        };

        renderFilter();
    }

    function categoryName() {
        return (
            document.querySelector(
                'h1'
            )?.textContent ||
            ''
        ).trim() ||
        'Nie wykryto';
    }

    function categoryOfferCount() {
        const heading =
            document.querySelector(
                'h1'
            );

        const roots =
            heading?.parentElement
                ? [
                    heading.parentElement,
                    document.body
                ]
                : [
                    document.body
                ];

        for (
            const root of roots
        ) {
            for (
                const element of root.querySelectorAll(
                    'div, span, p'
                )
            ) {
                const match =
                    norm(
                        element.textContent
                    ).match(
                        /^([\d\s.,]+(?:tys\.?|mln\.?)?\+?)\s*ofert(?:a|y)?$/
                    );

                if (match) {
                    const amount =
                        parseCompact(
                            match[1]
                        );

                    if (
                        amount !==
                        null
                    )
                        return amount;
                }
            }
        }

        return null;
    }

    function categoryScore(
        analysis
    ) {
        let score = 0;

        if (
            analysis.count !==
            null
        ) {
            if (
                analysis.count <=
                3000
            )
                score += 30;

            else if (
                analysis.count <=
                6000
            )
                score += 26;

            else if (
                analysis.count <=
                state.maxCategoryOffers
            )
                score += 20;

            else if (
                analysis.count <=
                state.maxCategoryOffers *
                1.5
            )
                score += 10;
        }

        if (
            analysis.strong >= 10
        )
            score += 40;

        else if (
            analysis.strong >= 7
        )
            score += 37;

        else if (
            analysis.strong >= 5
        )
            score += 34;

        else if (
            analysis.strong >= 3
        )
            score += 28;

        else if (
            analysis.strong === 2
        )
            score += 18;

        else if (
            analysis.strong === 1
        )
            score += 9;

        if (
            analysis.strong >=
            state.minStrongOffers
        )
            score += 15;

        if (
            analysis.top5 >=
            state.categoryMinSales *
            3
        )
            score += 10;

        else if (
            analysis.top5 >=
            state.categoryMinSales *
            2
        )
            score += 8;

        else if (
            analysis.top5 >=
            state.categoryMinSales
        )
            score += 4;

        if (
            analysis.max >=
            state.categoryMinSales *
            5
        )
            score += 5;

        else if (
            analysis.max >=
            state.categoryMinSales *
            3
        )
            score += 4;

        else if (
            analysis.max >=
            state.categoryMinSales *
            2
        )
            score += 2;

        return clamp(
            score,
            0,
            100
        );
    }

    function categoryVerdict(
        score
    ) {
        if (
            score >= 85
        )
            return {
                label:
                    'BANGER',

                cls:
                    'banger',

                desc:
                    'Bardzo mocna kategoria.'
            };

        if (
            score >= 65
        )
            return {
                label:
                    'DOBRA',

                cls:
                    'good',

                desc:
                    'Kategoria wygląda dobrze.'
            };

        if (
            score >= 45
        )
            return {
                label:
                    'DO SPRAWDZENIA',

                cls:
                    'medium',

                desc:
                    'Kategoria wymaga dalszej weryfikacji.'
            };

        return {
            label:
                'SŁABA',

            cls:
                'bad',

            desc:
                'Za mało popytu albo za duża konkurencja.'
        };
    }

    function analyzeCategory() {
        const startedAt =
            performance.now();

        const records =
            offerRecords();

        const allSales = [];
        const organicSales = [];
        const sponsoredSales = [];

        let unknown = 0;
        let sponsoredCount = 0;

        for (
            const record of records
        ) {
            if (
                record.sponsored
            )
                sponsoredCount++;

            if (
                record.sales ===
                null
            ) {
                unknown++;

                continue;
            }

            allSales.push(
                record.sales
            );

            (
                record.sponsored
                    ? sponsoredSales
                    : organicSales
            ).push(
                record.sales
            );
        }

        allSales.sort(
            (a, b) =>
                b - a
        );

        organicSales.sort(
            (a, b) =>
                b - a
        );

        sponsoredSales.sort(
            (a, b) =>
                b - a
        );

        const strong =
            allSales.filter(
                value =>
                    value >=
                    state.categoryMinSales
            );

        const result = {
            name:
                categoryName(),

            count:
                categoryOfferCount(),

            detected:
                records.length,

            withSales:
                allSales.length,

            organic:
                organicSales.length,

            promoted:
                sponsoredSales.length,

            sponsoredCount,

            unknown,

            strong:
                strong.length,

            strongOrganic:
                organicSales.filter(
                    value =>
                        value >=
                        state.categoryMinSales
                ).length,

            strongPromoted:
                sponsoredSales.filter(
                    value =>
                        value >=
                        state.categoryMinSales
                ).length,

            max:
                allSales[0] ||
                0,

            top5:
                avg(
                    allSales.slice(
                        0,
                        5
                    )
                ),

            ms:
                Math.round(
                    performance.now() -
                    startedAt
                )
        };

        result.score =
            categoryScore(
                result
            );

        result.verdict =
            categoryVerdict(
                result.score
            );

        return result;
    }

    function normalizeGtin(raw) {
        const digits =
            String(raw ?? '')
                .replace(
                    /\D/g,
                    ''
                );

        return [
            8,
            12,
            13,
            14
        ].includes(
            digits.length
        )
            ? digits
            : null;
    }

    function productGtin() {
        const sources = [
            document
                .documentElement
                ?.innerHTML ||
            '',

            document.body
                ?.innerText ||
            ''
        ];

        const patterns = [
            /["']gtin["']\s*:\s*["'](\d{8}|\d{12,14})["']/gi,

            /["']gtin["']\s*:\s*\[\s*["'](\d{8}|\d{12,14})["']/gi,

            /["']ean["']\s*:\s*["'](\d{8}|\d{12,14})["']/gi,

            /(?:GTIN|EAN)\s*:?\s*(\d{8}|\d{12,14})/gi
        ];

        for (
            const source of sources
        ) {
            for (
                const pattern of patterns
            ) {
                pattern.lastIndex =
                    0;

                let match;

                while (
                    (
                        match =
                            pattern.exec(
                                source
                            )
                    ) !== null
                ) {
                    const gtin =
                        normalizeGtin(
                            match[1]
                        );

                    if (gtin)
                        return gtin;
                }
            }
        }

        for (
            const script of document.querySelectorAll(
                'script'
            )
        ) {
            const source =
                script.textContent ||
                '';

            for (
                const pattern of patterns
            ) {
                pattern.lastIndex =
                    0;

                const match =
                    pattern.exec(
                        source
                    );

                if (match) {
                    const gtin =
                        normalizeGtin(
                            match[1]
                        );

                    if (gtin)
                        return gtin;
                }
            }
        }

        return null;
    }

    async function copyTextToClipboard(
        value
    ) {
        if (!value)
            return false;

        try {
            if (
                navigator.clipboard &&
                window.isSecureContext
            ) {
                await navigator.clipboard
                    .writeText(
                        value
                    );

                return true;
            }
        } catch (error) {
            console.warn(
                '[Natan Allegro] Clipboard API niedostępne.',
                error
            );
        }

        try {
            const textarea =
                document.createElement(
                    'textarea'
                );

            textarea.value =
                value;

            textarea.setAttribute(
                'readonly',
                ''
            );

            textarea.style.position =
                'fixed';

            textarea.style.opacity =
                '0';

            document.body.appendChild(
                textarea
            );

            textarea.select();

            const copied =
                document.execCommand(
                    'copy'
                );

            textarea.remove();

            return copied;
        } catch (error) {
            console.warn(
                '[Natan Allegro] Nie udało się skopiować GTIN/EAN.',
                error
            );

            return false;
        }
    }

    function productBrand() {
        const element =
            document.querySelector(
                '[data-analytics-view-label="brandLink"], [data-analytics-click-label="parameterLink"][data-analytics-click-value="Marka"]'
            );

        if (
            element
                ?.dataset
                .analyticsViewValue
        )
            return element
                .dataset
                .analyticsViewValue
                .trim();

        const candidate = [
            ...document.querySelectorAll(
                'div, p, span, td'
            )
        ].find(
            item =>
                /^marka:\s*/i.test(
                    (
                        item.textContent ||
                        ''
                    ).trim()
                )
        );

        return (
            (
                candidate
                    ?.textContent ||
                ''
            )
                .replace(
                    /^marka:\s*/i,
                    ''
                )
                .trim() ||
            'Nie wykryto'
        );
    }

    function productTitle() {
        return (
            document.querySelector(
                'h1'
            )?.textContent ||
            ''
        ).trim() ||
        'Nie wykryto';
    }

    function productRating() {
        const element =
            document.querySelector(
                '[data-analytics-view-label="productRating"]'
            );

        const value =
            Number(
                element
                    ?.getAttribute(
                        'data-analytics-view-custom-rating-value'
                    )
            );

        if (
            Number.isFinite(
                value
            )
        )
            return value;

        const aria =
            document.querySelector(
                '[aria-label^="ocena:"]'
            )?.getAttribute(
                'aria-label'
            ) ||
            '';

        const match =
            aria.match(
                /ocena:\s*([\d,.]+)/i
            );

        return match
            ? Number(
                match[1]
                    .replace(
                        ',',
                        '.'
                    )
            )
            : null;
    }

    function productReviewCounts() {
        const element =
            document.querySelector(
                '[data-analytics-view-label="productRating"]'
            );

        const ratingCount =
            Number(
                element
                    ?.getAttribute(
                        'data-analytics-view-custom-rating-count'
                    )
            );

        const text =
            element?.textContent ||
            document.body.innerText;

        const ratings =
            Number.isFinite(
                ratingCount
            )
                ? ratingCount
                : Number(
                    (
                        text.match(
                            /(\d[\d\s]*)\s+ocen/i
                        )?.[1] ||
                        ''
                    ).replace(
                        /\s/g,
                        ''
                    )
                ) ||
                0;

        const reviews =
            Number(
                (
                    text.match(
                        /(\d[\d\s]*)\s+recenzj/i
                    )?.[1] ||
                    ''
                ).replace(
                    /\s/g,
                    ''
                )
            ) ||
            0;

        return {
            ratings,
            reviews
        };
    }

    function productSales() {
        const ratingLink =
            document.querySelector(
                '[data-analytics-view-label="productRating"]'
            );

        if (ratingLink) {
            let current =
                ratingLink.parentElement;

            for (
                let level = 0;
                level < 4 &&
                current;
                level++
            ) {
                const text =
                    current.textContent ||
                    '';

                if (
                    /(?:osób|osoby|osoba)\s+kupi\w*\s+ostatnio/i.test(
                        text
                    )
                ) {
                    const sales =
                        parseSalesText(
                            text
                        );

                    if (
                        sales !==
                        null
                    )
                        return sales;
                }

                current =
                    current.parentElement;
            }
        }

        for (
            const element of document.querySelectorAll(
                'div, span, p'
            )
        ) {
            const text =
                norm(
                    element.textContent
                );

            if (
                !text.includes(
                    'ostatnio'
                ) ||
                !/(?:osób|osoby|osoba)\s+kupi\w*/.test(
                    text
                )
            )
                continue;

            const sales =
                parseSalesText(
                    text
                );

            if (
                sales !==
                null
            )
                return sales;
        }

        return null;
    }

    function catalogueOffers() {
        const link =
            document.querySelector(
                'a.other-offers-link-all[href="#inne-oferty-produktu"]'
            );

        if (!link)
            return null;

        const match =
            (
                link.textContent ||
                ''
            ).match(
                /wszystkie\s+oferty\s*\((\d[\d\s]*)\)/i
            );

        if (!match)
            return null;

        const value =
            Number(
                match[1]
                    .replace(
                        /\s/g,
                        ''
                    )
            );

        return Number.isFinite(
            value
        )
            ? value
            : null;
    }

    function officialShopInfo() {
        let label = '';

        for (
            const element of document.querySelectorAll(
                'div, p, span'
            )
        ) {
            const text =
                (
                    element.textContent ||
                    ''
                ).trim();

            if (
                /^od\s+oficjalny sklep/i.test(
                    text
                )
            ) {
                label =
                    text;

                break;
            }
        }

        const logo =
            document.querySelector(
                'img[alt*="logo oficjalnego sklepu" i]'
            );

        if (
            !label &&
            logo
        )
            label =
                logo.getAttribute(
                    'alt'
                ) ||
                '';

        const shop =
            label
                .replace(
                    /^od\s+oficjalny sklep\s*/i,
                    ''
                )
                .replace(
                    /^logo oficjalnego sklepu\s*/i,
                    ''
                )
                .trim();

        return {
            official:
                Boolean(
                    label ||
                    logo
                ),

            shop:
                shop ||
                'Nie wykryto'
        };
    }

    function sameBrandShop(
        brand,
        shop
    ) {
        const clean =
            value =>
                norm(value)
                    .replace(
                        /[^a-z0-9ąćęłńóśźż]/g,
                        ''
                    );

        const first =
            clean(brand);

        const second =
            clean(shop);

        return Boolean(
            first &&
            second &&
            (
                first === second ||
                first.includes(
                    second
                ) ||
                second.includes(
                    first
                )
            )
        );
    }

    function productPrice() {
        const candidates = [
            document.querySelector(
                '[data-analytics-interaction-custom-price]'
            )?.getAttribute(
                'data-analytics-interaction-custom-price'
            ),

            document.querySelector(
                '[data-analytics-view-label="price"]'
            )?.textContent
        ];

        for (
            const raw of candidates
        ) {
            if (!raw)
                continue;

            const direct =
                Number(
                    String(raw)
                        .replace(
                            ',',
                            '.'
                        )
                );

            if (
                Number.isFinite(
                    direct
                ) &&
                direct > 0
            )
                return direct;

            const match =
                String(raw)
                    .match(
                        /(\d[\d\s]*)[,.]([0-9]{2})\s*zł/i
                    );

            if (match)
                return Number(
                    match[1]
                        .replace(
                            /\s/g,
                            ''
                        ) +
                    '.' +
                    match[2]
                );
        }

        const matches = [
            ...(
                document.body.innerText ||
                ''
            ).matchAll(
                /(\d[\d\s]*)[,.]([0-9]{2})\s*zł/g
            )
        ]
            .map(
                match =>
                    Number(
                        match[1]
                            .replace(
                                /\s/g,
                                ''
                            ) +
                        '.' +
                        match[2]
                    )
            )
            .filter(
                value =>
                    value > 1
            );

        return matches.length
            ? matches[0]
            : null;
    }

    function roundUp89(price) {
        let candidate =
            Math.floor(
                price / 10
            ) *
            10 +
            9.89;

        if (
            candidate < price
        )
            candidate += 10;

        return (
            Math.round(
                candidate *
                100
            ) /
            100
        );
    }

    function smartProfitRule(
        purchase
    ) {
        let percent;

        if (
            purchase <= 200
        )
            percent = 25;

        else if (
            purchase <= 400
        )
            percent = 22.5;

        else if (
            purchase <= 500
        )
            percent = 20;

        else if (
            purchase <= 750
        )
            percent = 18;

        else if (
            purchase <= 1000
        )
            percent = 16;

        else if (
            purchase <= 1500
        )
            percent = 14;

        else
            percent = 12;

        const calculated =
            purchase *
            percent /
            100;

        const targetNet =
            Math.max(
                30,
                calculated
            );

        return {
            percent,

            targetNet:
                Math.round(
                    targetNet *
                    100
                ) /
                100,

            minimumApplied:
                calculated < 30
        };
    }

    function targetNetProfit(
        purchase
    ) {
        if (
            state.profitMode ===
            'custom'
        ) {
            return {
                percent:
                    null,

                targetNet:
                    state.profitCustom,

                minimumApplied:
                    false
            };
        }

        return smartProfitRule(
            purchase
        );
    }

    function pricing(
        purchase
    ) {
        if (
            !Number.isFinite(
                purchase
            )
        )
            return null;

        const commission =
            0.12;

        const tax =
            0.19;

        const profitRule =
            targetNetProfit(
                purchase
            );

        const targetNet =
            profitRule.targetNet;

        const profitBeforeTax =
            targetNet /
            (1 - tax);

        const minimum =
            (
                purchase +
                profitBeforeTax
            ) /
            (1 -
                commission);

        const suggested =
            roundUp89(
                minimum
            );

        const commissionValue =
            suggested *
            commission;

        const grossProfitBeforeTax =
            suggested -
            commissionValue -
            purchase;

        const incomeTax =
            Math.max(
                0,
                grossProfitBeforeTax *
                tax
            );

        const netProfit =
            grossProfitBeforeTax -
            incomeTax;

        return {
            purchase,
            commission,
            tax,
            targetNet,
            minimum,
            suggested,
            commissionValue,

            profitBeforeTax:
                grossProfitBeforeTax,

            incomeTax,
            netProfit,

            profitMode:
                state.profitMode,

            profitPercent:
                profitRule.percent,

            profitCustom:
                state.profitCustom,

            minimumProfitApplied:
                profitRule.minimumApplied
        };
    }

    function productScore(
        analysis
    ) {
        if (
            analysis.sales ===
                null ||
            analysis.sales <
                state.finderMinSales
        )
            return 0;

        if (
            analysis.price !==
                null &&
            analysis.price >
                state.finderMaxPrice
        )
            return 0;

        if (
            blockedBrandMatch(
                analysis.brand
            )
        )
            return 0;

        if (
            analysis.official &&
            analysis.brandMatchesShop &&
            (analysis.offers ?? 0) <
                8
        )
            return 0;

        let score = 0;

        if (
            analysis.sales >= 500
        )
            score += 40;

        else if (
            analysis.sales >= 300
        )
            score += 35;

        else if (
            analysis.sales >= 200
        )
            score += 31;

        else
            score += 27;

        if (
            analysis.rating !==
            null
        ) {
            if (
                analysis.rating >=
                4.95
            )
                score += 15;

            else if (
                analysis.rating >=
                4.9
            )
                score += 13;

            else if (
                analysis.rating >=
                4.8
            )
                score += 10;

            else if (
                analysis.rating >=
                4.7
            )
                score += 6;
        }

        if (
            analysis.ratings >= 500
        )
            score += 15;

        else if (
            analysis.ratings >= 250
        )
            score += 13;

        else if (
            analysis.ratings >= 100
        )
            score += 10;

        else if (
            analysis.ratings >= 50
        )
            score += 7;

        else if (
            analysis.ratings >= 20
        )
            score += 4;

        if (
            analysis.reviews >= 100
        )
            score += 10;

        else if (
            analysis.reviews >= 50
        )
            score += 8;

        else if (
            analysis.reviews >= 20
        )
            score += 6;

        else if (
            analysis.reviews >= 10
        )
            score += 4;

        if (
            analysis.offers !==
            null
        ) {
            if (
                analysis.offers >=
                    20 &&
                analysis.offers <=
                    60
            )
                score += 15;

            else if (
                analysis.offers >=
                    9 &&
                analysis.offers <
                    20
            )
                score += 12;

            else if (
                analysis.offers >
                    60 &&
                analysis.offers <=
                    120
            )
                score += 10;

            else if (
                analysis.offers >=
                8
            )
                score += 7;
        }

        return clamp(
            score,
            0,
            100
        );
    }

    function productVerdict(
        analysis
    ) {
        if (
            analysis.sales ===
            null
        )
            return {
                label:
                    'BRAK DANYCH',

                cls:
                    'medium',

                desc:
                    'Nie wykryto sprzedaży produktu.'
            };

        if (
            analysis.price !==
                null &&
            analysis.price >
                state.finderMaxPrice
        )
            return {
                label:
                    'ODRZUĆ',

                cls:
                    'bad',

                desc:
                    `Cena ${fmt(
                        analysis.price,
                        2
                    )} zł przekracza limit Product Findera ${fmt(
                        state.finderMaxPrice,
                        0
                    )} zł.`
            };

        const blocked =
            blockedBrandMatch(
                analysis.brand
            );

        if (blocked)
            return {
                label:
                    'ODRZUĆ',

                cls:
                    'bad',

                desc:
                    `Marka „${blocked}” znajduje się na blacklistcie Product Findera.`
            };

        if (
            analysis.sales <
            state.finderMinSales
        )
            return {
                label:
                    'ODRZUĆ',

                cls:
                    'bad',

                desc:
                    `Sprzedaż produktu wynosi ${analysis.sales}; wymagane minimum to ${state.finderMinSales}.`
            };

        if (
            analysis.official &&
            analysis.brandMatchesShop &&
            (analysis.offers ?? 0) <
                8
        )
            return {
                label:
                    'ODRZUĆ',

                cls:
                    'bad',

                desc:
                    'Oficjalny sklep tej samej marki i mniej niż 8 ofert w katalogu.'
            };

        if (
            analysis.score >= 85
        )
            return {
                label:
                    'BANGER',

                cls:
                    'banger',

                desc:
                    'Bardzo mocny produkt.'
            };

        if (
            analysis.score >= 65
        )
            return {
                label:
                    'DOBRY',

                cls:
                    'good',

                desc:
                    'Produkt wygląda dobrze.'
            };

        if (
            analysis.score >= 45
        )
            return {
                label:
                    'ŚREDNI',

                cls:
                    'medium',

                desc:
                    'Prawdopodobnie mały popyt.'
            };

        return {
            label:
                'ODRZUĆ',

            cls:
                'bad',

            desc:
                'Produkt nie uzyskał wystarczającej oceny.'
        };
    }

    function analyzeProduct() {
        const startedAt =
            performance.now();

        const brand =
            productBrand();

        const officialInfo =
            officialShopInfo();

        const counts =
            productReviewCounts();

        const result = {
            title:
                productTitle(),

            brand,

            official:
                officialInfo.official,

            shop:
                officialInfo.shop,

            brandMatchesShop:
                sameBrandShop(
                    brand,
                    officialInfo.shop
                ),

            offers:
                catalogueOffers(),

            sales:
                productSales(),

            rating:
                productRating(),

            ratings:
                counts.ratings,

            reviews:
                counts.reviews,

            gtin:
                productGtin(),

            price:
                productPrice(),

            productId:
                currentProductId(),

            offerId:
                currentOfferId(),

            url:
                canonicalOfferUrl(),

            category:
                productCategoryContext(),

            ms: 0
        };

        result.pricing =
            pricing(
                result.price
            );

        result.score =
            productScore(
                result
            );

        result.verdict =
            productVerdict(
                result
            );

        result.ms =
            Math.round(
                performance.now() -
                startedAt
            );

        return result;
    }

    function runCategory() {
        const button =
            document.getElementById(
                'natan-category-run'
            );

        button.disabled =
            true;

        button.textContent =
            'Analizowanie...';

        requestAnimationFrame(
            () => {
                lastCategory =
                    analyzeCategory();

                renderCategory();

                renderAdvanced();

                button.disabled =
                    false;

                button.textContent =
                    'Analizuj kategorię';
            }
        );
    }

    function runProduct() {
        const button =
            document.getElementById(
                'natan-product-run'
            );

        button.disabled =
            true;

        button.textContent =
            'Analizowanie...';

        requestAnimationFrame(
            async () => {
                lastProduct =
                    analyzeProduct();

                renderProduct();

                if (
                    lastProduct.gtin
                ) {
                    lastProduct.gtinCopied =
                        await copyTextToClipboard(
                            lastProduct.gtin
                        );
                } else {
                    lastProduct.gtinCopied =
                        false;
                }

                if (
                    state.finderAutoSave
                ) {
                    try {
                        lastProduct.finderRecord =
                            await finderSaveAnalysis(
                                lastProduct
                            );

                        lastProduct.finderSaved =
                            true;

                        await renderFinderDatabase();
                    } catch (error) {
                        console.error(
                            '[Natan Allegro] Błąd zapisu Product Finder.',
                            error
                        );

                        lastProduct.finderSaved =
                            false;
                    }
                }

                renderProduct();

                button.disabled =
                    false;

                button.textContent =
                    'Analizuj produkt';
            }
        );
    }

